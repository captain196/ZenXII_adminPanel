# Deny all web access to the blueprints tree.
#
# Design and planning material, not application code. The root .htaccess denies
# .md, which covers most of it — but NOT .html, and this tree contains two
# ~250 KB working prototypes of the Certificate Designer
# (certificates/design/prototype.html and prototype.artifact.html) that would
# otherwise be served verbatim once this branch reaches production.
#
# Directory-scoped so it ships as a new file and cannot collide with
# production's hand-maintained root .htaccess.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
