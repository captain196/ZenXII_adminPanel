rules_version = '2';

// ══════════════════════════════════════════════════════════════════════════
// ADVERSARIAL FIXTURE FOR THE RULES PARSERS.
//
// Every shape here has broken a parser in this repository at least once, or is
// a near-miss of one that did. It exists so a census tool can be proven to FAIL
// on a hostile input rather than trusted because its totals looked stable.
//
// The expected classification of every arm is stated inline as EXPECT:<CLASS>.
// tests/Unit/RulesParserAdversarialTest.php reads those markers and compares
// them to what the parser actually reports, so this file is self-describing and
// cannot drift away from its assertions silently.
//
// Padding is added at the end because the census tools refuse inputs under
// 10,000 bytes (a truncated production pull must never be analysed as if it
// were complete).
// ══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()      { return request.auth != null; }
    function isAdmin()     { return isAuth() && request.auth.token.role == 'Admin'; }
    function isStaff()     { return isAuth() && request.auth.token.role != 'Parent'; }
    function isSuperAdmin(){ return isAuth() && request.auth.token.role == 'Super Admin'; }
    function isSameSchool(){ return resource == null || resource.data.schoolId == request.auth.token.school_id; }
    function isSameSchoolWrite() { return request.resource.data.schoolId == request.auth.token.school_id; }

    // ── 1. SINGLE-LINE BLOCKS ────────────────────────────────────────────
    // The original defect. A non-greedy `(.*?)\n    \}` scan starting here ran
    // past this block's own inline `}` and swallowed everything down to the
    // next block that closed on its own line — attributing THAT block's arms
    // to THIS collection.
    match /singleLineDeny/{docId}    { allow read, write: if false; }            // EXPECT:DENY
    match /singleLineAdmin/{docId}   { allow write: if isAdmin(); }              // EXPECT:UNSCOPED
    match /singleLineTenant/{docId}  { allow write: if isSameSchoolWrite(); }    // EXPECT:TENANT

    // The victim: a multi-line block immediately after the single-line ones.
    // A broken parser reports THIS arm under `singleLineDeny`.
    match /swallowVictim/{docId} {
      allow read: if isSameSchool();
      allow write: if isAdmin();                                                 // EXPECT:UNSCOPED
    }

    // ── 2. NESTED BLOCKS ─────────────────────────────────────────────────
    // The child's arms must NOT be counted against the parent, and the child
    // must still be found on its own.
    match /parentCollection/{docId} {
      allow read: if isSameSchool();
      allow write: if isAdmin();                                                 // EXPECT:UNSCOPED

      match /childSubcollection/{childId} {
        allow read: if isSameSchool();
        allow write: if false;                                                   // EXPECT:DENY
      }
    }

    // ── 3. DUPLICATE ALLOW STATEMENTS ────────────────────────────────────
    // Firestore ORs them. A parser that keeps only the first or last reports a
    // boundary the engine does not enforce. BOTH must appear.
    //
    // ORDER IS DELIBERATE: the NARROWER arm (owner-scoped — exactly one user)
    // is listed FIRST and the BROADER one (staff-own-tenant — every staff
    // member in the tenant) SECOND. A tool that reports "the first arm" would
    // say owner-scoped; the engine actually permits anything either arm admits,
    // so the honest answer is the broader one. Reversing this order would make
    // first-wins and weakest-wins agree, and the test could no longer tell them
    // apart.
    match /duplicateArms/{docId} {
      allow read: if isSameSchool();
      allow update: if isAuth() && resource.data.ownerId == request.auth.uid;    // EXPECT:OWNER
      allow update: if isAdmin() && isSameSchoolWrite();                         // EXPECT:TENANT+RBAC
    }

    // ── 4. COMMENTS CONTAINING RULE-LIKE SYNTAX ──────────────────────────
    // Prose that mentions a helper must never be mistaken for a check, and a
    // commented-out arm must never be counted as live.
    match /commentTrap/{docId} {
      // Historically this was `allow write: if isAdmin() && isSameSchool();`
      // and we considered match /commentTrap/{docId} { allow write: if false; }
      // allow write: if isSameSchoolWrite();
      allow read: if isSameSchool();
      allow write: if isAdmin();                                                 // EXPECT:UNSCOPED
    }

    // ── 5. INLINE BRACES INSIDE A CONDITION ──────────────────────────────
    // Map literals and `in [...]` sets put braces/brackets inside the arm. A
    // depth counter that does not expect them closes the block early.
    match /inlineBraces/{docId} {
      allow read: if isSameSchool();
      allow update: if isAdmin()
                    && isSameSchoolWrite()
                    && request.resource.data.status in ['a', 'b']
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']); // EXPECT:TENANT+RBAC
    }

    // ── 6. REPEATED PREDICATES ───────────────────────────────────────────
    // `allow write: if isAdmin();` recurs verbatim throughout a real ruleset.
    // A VALUE-based diff (array_diff) reports "0 changed lines" for a real
    // change because the removed string still exists elsewhere. Diffs must be
    // POSITIONAL.
    match /repeatedA/{docId} { allow write: if isAdmin(); }                      // EXPECT:UNSCOPED
    match /repeatedB/{docId} { allow write: if isAdmin(); }                      // EXPECT:UNSCOPED
    match /repeatedC/{docId} { allow write: if isAdmin(); }                      // EXPECT:UNSCOPED

    // ── 7. ALREADY-FIXED SHAPES ──────────────────────────────────────────
    // Must NOT be reported as vulnerable. Counting the fix as the defect is the
    // error that produced the withdrawn "45 arms across 44 collections" figure.
    match /alreadyFixedSplit/{docId} {
      allow read: if isSameSchool();
      allow create, update: if isAdmin() && isSameSchoolWrite();                 // EXPECT:TENANT+RBAC
      allow delete: if isAdmin()
        && resource != null
        && resource.data.schoolId == request.auth.token.school_id;               // EXPECT:TENANT+RBAC
    }
    match /alreadyFixedComposed/{docId} {
      allow read: if isStaff() && isSameSchool();
      allow write: if false;                                                     // EXPECT:DENY
    }

    // ── 8. PER-OPERATION ARMS ────────────────────────────────────────────
    // get/list are distinct from read. A tool that only knows `read` misses
    // that `list` can leak a whole collection even when `get` is scoped.
    match /perOperation/{docId} {
      allow get:    if isSameSchool();
      allow list:   if isStaff();
      allow create: if isAdmin() && isSameSchoolWrite();                         // EXPECT:TENANT+RBAC
      allow update: if isAdmin();                                                // EXPECT:UNSCOPED
      allow delete: if false;                                                    // EXPECT:DENY
    }

    // ── 9. PLATFORM ──────────────────────────────────────────────────────
    match /platformOnly/{docId} {
      allow read, write: if isSuperAdmin();                                      // EXPECT:PLATFORM
    }

    // ── 10. UNCLASSIFIABLE ───────────────────────────────────────────────
    // No role, no tenant, no owner. Must surface as INVESTIGATE, never be
    // silently dropped — a dropped arm is an unaudited arm.
    match /publicish/{docId} {
      allow read: if true;
      allow write: if request.time < timestamp.date(2030, 1, 1);                 // EXPECT:INVESTIGATE
    }
  }
}

