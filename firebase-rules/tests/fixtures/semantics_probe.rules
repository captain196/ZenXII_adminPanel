rules_version = '2';

// ══════════════════════════════════════════════════════════════════════════
// FIRESTORE EVALUATION-SEMANTICS PROBE
//
// Every classification rule in scripts/lib/rules_parser.php encodes a belief
// about how the Firestore engine evaluates a condition. This ruleset exists so
// those beliefs can be MEASURED against the real engine instead of reasoned
// about, because reasoning about them has already been wrong three times in
// this programme.
//
// Each collection isolates exactly ONE semantic question. The companion suite
// sec7_engine_semantics.test.js states the parser's prediction beside the
// measured result, so a divergence is a test failure rather than a silent
// modelling error.
//
// NOTHING HERE IS DEPLOYED. It is a laboratory fixture, never an artifact.
// ══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()  { return request.auth != null; }
    function isStaff() { return isAuth() && request.auth.token.role != 'Parent'; }
    function sameSchoolStored()   { return resource.data.schoolId == request.auth.token.school_id; }
    function sameSchoolIncoming() { return request.resource.data.schoolId == request.auth.token.school_id; }
    function nullTolerantSchool() { return resource == null || resource.data.schoolId == request.auth.token.school_id; }

    // ── Q1. Does a NULL DEREFERENCE in the LEFT operand of `||` deny the
    //        whole arm, or does the right operand rescue it?
    //
    // On DELETE `request.resource` is null. If the engine denies on the
    // erroring operand, an arm like this is dead for delete. If it takes the
    // right branch, the arm is tenant-bound and alive.
    //
    // rules_parser.php predicts: the surviving path binds the tenant, so this
    // is NOT a cross-tenant finding either way.
    match /q1_orRescue/{docId} {
      allow read: if true;
      allow write: if isStaff() && (sameSchoolIncoming() || sameSchoolStored());
    }

    // ── Q2. Same shape WITHOUT a rescuing branch.
    // Expected: delete is impossible (null deref, no alternative path).
    // rules_parser.php predicts: null-deref-denies.
    match /q2_noRescue/{docId} {
      allow read: if true;
      allow write: if isStaff() && sameSchoolIncoming();
    }

    // ── Q3. `resource == null ||` on CREATE.
    // `resource` is ALWAYS null on create, so the left disjunct is
    // unconditionally true and the school comparison after it is unreachable.
    // rules_parser.php predicts: the tenant check evaporates -> cross-tenant
    // create is ALLOWED.
    match /q3_createFailOpen/{docId} {
      allow read: if true;
      allow write: if isStaff() && nullTolerantSchool();
    }

    // ── Q4. The same fail-open, but with a BINDING sibling reached via `&&`.
    // rules_parser.php predicts: still tenant-bound on create, because
    // sameSchoolIncoming() must also hold. (This is the notificationPreferences
    // shape that an earlier heuristic wrongly flagged.)
    match /q4_createBoundSibling/{docId} {
      allow read: if true;
      allow write: if isStaff() && nullTolerantSchool() && sameSchoolIncoming();
    }

    // ── Q5. DUPLICATE allow arms. Firestore should OR them, so the WEAKER arm
    // decides. If it instead took the first or the last, every census that
    // resolves to the weakest arm would be wrong.
    match /q5_duplicateArms/{docId} {
      allow read: if isStaff() && sameSchoolStored();   // narrow: same school only
      allow read: if isAuth();                          // broad: anyone logged in
      allow write: if false;
    }

    // ── Q6. Reading a NON-EXISTENT document through a `resource == null ||`
    // arm. rules_parser.php treats this as harmless (nothing to disclose) and
    // must NOT report it as a cross-tenant finding.
    match /q6_missingDocRead/{docId} {
      allow read: if isStaff() && nullTolerantSchool();
      allow write: if false;
    }

    // ── Q7. Strict read: no null tolerance. A missing document must fail
    // CLOSED rather than return empty.
    match /q7_strictRead/{docId} {
      allow read: if isStaff() && resource != null && sameSchoolStored();
      allow write: if false;
    }

    // ── Q8. LIST vs GET. `get` is scoped, `list` is not. A query must be
    // evaluated against the LIST arm, so an unscoped list leaks the collection
    // even though every individual get would be refused.
    match /q8_listWiderThanGet/{docId} {
      allow get:  if isStaff() && sameSchoolStored();
      allow list: if isAuth();
      allow write: if false;
    }

    // ── Q9. The reverse: `list` scoped, `get` not. Confirms the two really are
    // independent rather than one implying the other.
    match /q9_getWiderThanList/{docId} {
      allow get:  if isAuth();
      allow list: if isStaff() && sameSchoolStored();
      allow write: if false;
    }

    // ── Q10. Does a scoped LIST require the QUERY to carry the filter, or is
    // it enough that the returned documents happen to match? Firestore should
    // reject the query unless it is provably within the rule.
    match /q10_queryMustBeProvable/{docId} {
      allow read: if isStaff() && sameSchoolStored();
      allow write: if false;
    }

    // ── Q11. The SEC-4 short-circuit, isolated. A role disjunct with no school
    // comparison must grant across tenants.
    match /q11_roleShortCircuit/{docId} {
      allow read: if isStaff() || (nullTolerantSchool() && resource.data.ownerId == request.auth.uid);
      allow write: if false;
    }

    // ── Q12. The corrected composition. Same predicates, `&&` instead of `||`.
    match /q12_roleComposed/{docId} {
      allow read: if nullTolerantSchool() && (isStaff() || resource.data.ownerId == request.auth.uid);
      allow write: if false;
    }

    // ── Q13. OWNER-scoping with NO school comparison. Safe only while ids are
    // globally unique. This probe deliberately creates the id COLLISION that a
    // per-school id scheme would produce, to show exactly what breaks.
    match /q13_ownerNoTenant/{docId} {
      allow read: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }
  }
}

