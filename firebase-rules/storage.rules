rules_version = '2';

// ════════════════════════════════════════════════════════════════════════
// Firebase Storage Security Rules — SchoolSync ERP
// Phase A — Tenant-isolated cover-all (2026-05-15)
// ════════════════════════════════════════════════════════════════════════
//
// This is the FIRST hardening pass over Storage rules. Scope is intentional-
// ly narrow: every production-active path is matched, and the only gating
// requirement on read/write is that the requester's `school_id` JWT custom
// claim equals the school identifier embedded in the path. NO MIME enforce-
// ment, NO per-role gating (beyond inherent path scoping), NO size caps.
// Those are Phase B (role gating) and Phase C (MIME + size).
//
// Goals of Phase A:
//   1. Restore the pre-2026-05-15 production functionality (every current
//      upload flow continues working).
//   2. Add cross-tenant isolation — a logged-in user from school SCH_A can
//      no longer write to school SCH_B's bucket prefixes.
//   3. Keep blast radius minimal so rollback to the recovery rule is a
//      one-paste operation.
//
// ────────────────────────────────────────────────────────────────────────
// CRITICAL INVARIANT — school_id ↔ {schoolName} equivalence
// ────────────────────────────────────────────────────────────────────────
// The legacy `/{schoolName}/...` match blocks below rely on the following
// session/claim invariant, audited and confirmed in Verification Audit A
// (2026-05-15):
//
//   session['school_id']  == session['schoolName']  == SCH_XXXXXX
//   JWT claim school_id   == session['school_id']    (setFirebaseClaims)
//   Legacy Storage path {schoolName} segment == session['schoolName']
//
//   ⇒  request.auth.token.school_id == {schoolName} path segment
//
// Both login flows (Admin_login.php:222-239 and Admin_login.php:439-450)
// assign the SAME variable to both session keys, so the equivalence is
// structurally guaranteed today. ANY future change that splits these two
// session keys — assigning different values to 'school_id' and 'schoolName'
// — would silently break every {schoolName}/... legacy path. Audit any
// new login or session-mutation code for this invariant.
//
// ────────────────────────────────────────────────────────────────────────
// IMPORTANT — getDownloadUrl() bypasses these Storage Rules
// ────────────────────────────────────────────────────────────────────────
// Firebase Storage's getDownloadUrl() and the legacy ?alt=media&token=...
// URL pattern produce long-lived public access tokens that BYPASS these
// rules entirely. Anyone holding the URL can fetch the object regardless
// of school_id / role. Mitigations in place:
//
//   • URLs are stored ONLY inside Firestore docs gated by firestore.rules;
//     the URL is as private as the doc.
//   • Client apps that open these URLs MUST validate:
//       - scheme: https only (no http, no other schemes)
//       - host:   firebasestorage.googleapis.com only
//       - format: reject malformed URLs / unknown encodings
//     before invoking Intent.ACTION_VIEW / WebView / equivalent.
//     See Parent/HomeworkScreen.kt:863-933 and the Finding #30 warning.
//   • Signed URLs with TTL + server-side signing are deferred to Phase 4.
//
// ────────────────────────────────────────────────────────────────────────
// PHP Admin SDK BYPASSES Storage Rules
// ────────────────────────────────────────────────────────────────────────
// All server-side PHP uploads via $this->firebase->uploadFile() and
// $this->CM->handleFileUpload() use a service-account token. These rules
// do NOT govern those uploads. The match blocks below cover those PHP
// paths anyway to defend against direct client-side writes to the same
// paths (a hostile authenticated user crafting a direct Storage REST call
// to schools/SCH_B/logo/... etc.).
//
// ────────────────────────────────────────────────────────────────────────
// LEGACY BUCKET DEPRECATED
// ────────────────────────────────────────────────────────────────────────
// graders-1c047.appspot.com is classified as deprecated legacy infrastruc-
// ture (Verification Audit B, 2026-05-15). Common_model1.php is dead code
// with zero production callers; the service account is commented out in
// application/config/firebase.php. No Phase A rules deploy there. Cleanup
// queued separately.

service firebase.storage {
  match /b/{bucket}/o {

    // ════════════════════════════════════════════════════════════════════
    //  MODERN LOWERCASE-PREFIX PATHS
    // ════════════════════════════════════════════════════════════════════

    // ─── L1: HOMEWORK attachments ───────────────────────────────────────
    // Path:  homework/{schoolId}/{homeworkId}/{path=**}
    // Homework Attachment Workstream RESUMED (Teacher app writes here).
    //
    // Phase C hardening (2026-07-02, audit C1): tenant isolation (school_id
    // == path segment) is no longer the ONLY gate. Create/update now enforce
    // a MIME allowlist and a per-file size cap SERVER-SIDE, mirroring the
    // Teacher client's HomeworkAttachmentUploader caps EXACTLY:
    //     ALLOWED_MIME_TYPES = image/jpeg, image/png, image/webp, application/pdf
    //     MAX_FILE_BYTES     = 10 MiB (10 * 1024 * 1024 = 10485760, inclusive)
    // This closes the gap where a modified APK / direct Storage REST call
    // could push arbitrary file types or unbounded sizes into a school's
    // homework prefix. The per-homework file COUNT cap (5) is not expressible
    // in Storage rules and remains a client + Firestore-doc concern.
    //
    // delete is split out: on delete, request.resource is null (no size /
    // contentType), so it must NOT carry the MIME/size predicates — otherwise
    // the Teacher app's rollback + delete-on-homework-delete cleanup would be
    // denied. Delete stays gated on tenant isolation only.
    match /homework/{schoolId}/{homeworkId}/{path=**} {
      allow read:   if request.auth != null
                    && request.auth.token.school_id == schoolId;
      allow create, update:
                    if request.auth != null
                    && request.auth.token.school_id == schoolId
                    && request.resource.size <= 10 * 1024 * 1024
                    && request.resource.contentType in [
                         'image/jpeg', 'image/png', 'image/webp', 'application/pdf'
                       ];
      allow delete: if request.auth != null
                    && request.auth.token.school_id == schoolId;
    }

    // ─── L2: GALLERY media (Teacher GalleryMediaUploader) ───────────────
    // Path:  galleryMedia/{schoolId}/{albumId}/{path=**}
    //
    // Phase B/C hardening (2026-07-09, audit H2): tenant isolation was the
    // ONLY gate, so ANY authenticated same-school user — including a Parent
    // or Student token — could push arbitrarily large files of any type
    // straight into a school's gallery prefix (storage-cost DoS + content-
    // hosting abuse), even though only staff can register the matching
    // galleryMedia Firestore doc. Block non-staff writers and bound object
    // size to the Teacher GalleryMediaUploader's MAX_VIDEO_BYTES (50 MiB).
    // A contentType MIME allowlist is intentionally deferred: the uploader
    // uses putFile() with Uri-inferred MIME (no explicit StorageMetadata),
    // so a contentType predicate risks rejecting legitimate uploads — add it
    // only once the uploader sets explicit metadata (mirrors L3 Stories).
    // delete stays tenant-only: request.resource is null on delete, so the
    // size predicate can't apply, and the uploader's orphan-rollback needs it.
    match /galleryMedia/{schoolId}/{albumId}/{path=**} {
      allow read:   if request.auth != null
                    && request.auth.token.school_id == schoolId;
      allow create, update:
                    if request.auth != null
                    && request.auth.token.school_id == schoolId
                    && !(request.auth.token.role in
                         ['Student','student','Parent','parent','Guardian','guardian'])
                    // D1 (2026-07-12): backstop lowered 50→25 MiB to match the
                    // unified conservative policy (image 3MB / video 25MB). The
                    // finer per-type split is enforced client-side + in PHP.
                    && request.resource.size <= 25 * 1024 * 1024;
      allow delete: if request.auth != null
                    && request.auth.token.school_id == schoolId;
    }

    // ─── L3: STORIES (Teacher-posted via StoryMediaUploader) ────────────
    // Path:  stories/{schoolId}/{teacherId}/{path=**}
    // M4 hardening (2026-07-05): block NON-STAFF writers (parents only read
    // stories, never upload) and bound object size (was unbounded).
    // 2026-07-13: StoryMediaUploader now sets an EXPLICIT contentType on both
    // putFile (media) and putBytes (video poster), so we can finally gate the
    // MIME to image/* | video/* — closing the "any 300 MB blob of any type"
    // hole. Per-type BYTE caps stay app-side (10 MB image / 50 MB video, post-
    // compression) + PHP; the 300 MB rule cap is the coarse server backstop
    // (matches the uploader's raw video cap so no legit upload is rejected).
    // Delete stays tenant-only (request.resource is null on delete) so the
    // rollback + delete-on-story-delete path works.
    match /stories/{schoolId}/{teacherId}/{path=**} {
      allow read:   if request.auth != null
                    && request.auth.token.school_id == schoolId;
      allow create, update:
                    if request.auth != null
                    && request.auth.token.school_id == schoolId
                    && !(request.auth.token.role in
                         ['Student','student','Parent','parent','Guardian','guardian'])
                    && request.resource.size <= 300 * 1024 * 1024
                    && request.resource.contentType != null
                    && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if request.auth != null
                    && request.auth.token.school_id == schoolId;
    }

    // ─── L4: STORIES (Admin-posted via Stories.php) ─────────────────────
    // Path:  stories/admin/{schoolId}/{adminId}/{path=**}
    // Distinct from the block above: a literal 'admin' second segment instead
    // of a schoolId. Both patterns coexist via the OR semantic of Storage
    // rules — a path is allowed if either matching block allows it.
    //
    // RECOVERED FROM PRODUCTION 2026-08-30. This block was LIVE and in no
    // checkout: a whole-file deploy from disk would have deleted it and broken
    // admin-posted Stories media for every school. Caught by diffing the live
    // ruleset against disk before deploying and finding 27 deletions, of which
    // this was one. It is load-bearing, not dead — Storage_path_map.php builds
    // this exact path in three places.
    match /stories/admin/{schoolId}/{adminId}/{path=**} {
      allow read:  if request.auth != null
                   && request.auth.token.school_id == schoolId;
      allow write: if request.auth != null
                   && request.auth.token.school_id == schoolId;
    }

    // NOTE (2026-07-13): the old L4 block for `stories/admin/{schoolId}/{adminId}/**`
    // was REMOVED — it was dead. Admin stories are written by Stories.php to
    // `schools/{schoolId}/stories/{adminId}/...` (covered by L6 below) via the
    // Admin SDK, which bypasses Storage rules entirely. No writer ever used the
    // `stories/admin/...` path, so the rule only misled readers of this file.

    // ─── L5: MESSAGES (Parent + Teacher chat attachments) ───────────────
    // Path:  messages/{schoolId}/{conversationId}/{path=**}
    // Phase A: same-school authenticated read AND write, NO role filter
    // (parents legitimately write here). Conversation-membership and
    // parent-of-this-student checks deferred (Phase 4, Firestore lookup).
    match /messages/{schoolId}/{conversationId}/{path=**} {
      allow read:  if request.auth != null
                   && request.auth.token.school_id == schoolId;
      allow write: if request.auth != null
                   && request.auth.token.school_id == schoolId;
    }

    // ─── L6: CANONICAL SCHOOL TREE — schools/{schoolId}/... ─────────────
    // As of 2026-06-13 this is the ONE canonical, ID-keyed root for every
    // file a school owns. schoolId is the SCH_XXXXXX id (== auth token
    // school_id claim), NOT the school name or login code.
    // Sub-trees and their writers:
    //   schools/{schoolId}/logo|logos/{file}            School_config::upload_logo, Superadmin_schools
    //   schools/{schoolId}/holidays|academic/{file}     School_config::upload_document
    //   schools/{schoolId}/reportcard/{file}            School_config report-card template
    //   schools/{schoolId}/circulars/{file}             Communication.php attachments
    //   schools/{schoolId}/students/{userId}/profile|documents/...   Sis.php (admission + docs page)
    //   schools/{schoolId}/staff/{staffId}/profile|documents/...     Staff.php
    //   schools/{schoolId}/events/{eventId}/...          Schools.php gallery
    //   schools/{schoolId}/stories/{adminId}/...         Stories.php
    // Broad `{path=**}` covers all sub-trees and any future additions
    // under schools/{schoolId}/ without rule churn.
    // ─── SUPPORT DESK attachments ─────────────────────────────────────────
    // Path: schools/{schoolId}/support/{reporterId}/{ticketId}/{n}.jpg
    //
    // This is the FIRST genuine parent client write under schools/{schoolId}/.
    // The broad block below denies it: D5 gated writes to non-parent roles on
    // the finding that "NO rule-subject client writes here". That was true in
    // July 2026 and stopped being true when Support shipped in August — a parent
    // carries role "Parent" (verified against the live claim), so every upload
    // was refused and the whole attachment chain (Add photo, the 3-file cap, the
    // panel's signed-URL endpoint) has never once worked. Storage confirms 0
    // objects under any support/ prefix.
    //
    // THE OWNER IS IN THE PATH on purpose. Attachments upload BEFORE the ticket
    // document is created (SupportViewModel: upload at 266, create at 281), so
    // firestore.get() on the ticket cannot authorise the write — there is
    // nothing to read yet. Carrying reporterId as a path segment is what makes
    // "only your own files" expressible at all.
    //
    // Staff never read through this rule: the panel uses the Admin SDK, which
    // bypasses rules, and hands out 5-minute signed URLs.
    //
    // ⚠ The read arm is currently SUBSUMED by the broad schools/{schoolId}/
    // {path=**} read, which grants any same-school token a read of any object in
    // the tree. Storage rules OR together, so a narrower block cannot subtract
    // that. It is written here as the intended contract and takes effect the
    // moment that broad read is narrowed.
    match /schools/{schoolId}/support/{reporterId}/{ticketId}/{fileName} {
      allow read: if request.auth != null
                  && request.auth.token.school_id == schoolId
                  && request.auth.uid == reporterId;

        // CREATE, not write. `allow write` is shorthand for create+update+delete,
        // and allow statements OR together — so the `allow delete: if false` that
        // used to sit below this was dead code that could subtract nothing, while
        // the comment beside it claimed the opposite. A parent — or anyone holding
        // their ID token — could delete or overwrite their own attachment. On a
        // `conduct` ticket that is the complainant destroying or substituting the
        // evidence in an open investigation, and it leaves no trace: Storage emits
        // no audit event, and supportTickets.attachments still declares the name.
        //
        // create-only IS the control. Omitting update and delete denies them by
        // default, which is why no explicit deny follows — a deny line that reads
        // as load-bearing but is not is worse than no line at all. Nothing is lost:
        // ticketId is minted per ticket, so 1..3.jpg are always new objects.
      allow create: if request.auth != null
                    && request.auth.token.school_id == schoolId
                    && request.auth.uid == reporterId
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType == 'image/jpeg'
                    && fileName.matches('[1-3]\\.jpg');
    }

    match /schools/{schoolId}/{path=**} {
      // READ MOVED OUT of this block on 2026-08-30 — see L6a/L6b below.
      //
      // It granted read to any token whose school_id matched, for EVERY object
      // under the school tree. Correct for logos, circulars and report cards;
      // wrong for support-ticket attachments, where a parent's photographed
      // evidence became readable by every other parent in the school. Firestore
      // already restricts the ticket DOCUMENT to its reporter, so document-level
      // and object-level access disagreed.
      //
      // A narrower block could not fix it: Storage rules OR together, so the
      // owner-scoped support block above grants the owner access and subtracts
      // nothing from anyone else. The broad grant had to be withdrawn and
      // re-issued per sub-tree, which is what L6a/L6b do.
      //
      // D5 (2026-07-12): write gated to non-student/parent/guardian. Audit
      // confirmed NO rule-subject client writes here (real writers are
      // admin-panel Admin-SDK, which bypasses rules) — this is a defence-in-
      // depth backstop closing the "any same-school token can write anywhere
      // under the school tree" hole. Read stays open (parents/students read
      // logos, circulars, report cards, etc. under schools/{schoolId}/).
      // L12 (2026-07-13): 50 MiB per-object backstop. Real writers are the
      // Admin SDK (bypasses rules); this only bounds a rogue non-student token
      // uploading arbitrarily large blobs under the school tree (circular
      // attachments etc. had no size cap, unlike gallery's 25 MiB).
      allow write: if request.auth != null
                   && request.auth.token.school_id == schoolId
                   && !(request.auth.token.role in
                        ['Student','student','Parent','parent','Guardian','guardian'])
                   // `<=`, not `<` — every other block in this file uses `<=`,
                   // so a file of exactly 50 MiB was rejected here alone.
                   && request.resource.size <= 50 * 1024 * 1024;
    }

    // ─── L6a: READ for every school sub-tree EXCEPT support ────────────────
    // The first segment is captured as {area} precisely so it can be tested.
    // `{path=**}` yields a Path, which rules cannot index, so the exclusion is
    // not expressible in the broad block above.
    //
    // Still readable school-wide, unchanged from the grant this replaces:
    // logo|logos, holidays, academic, reportcard, circulars, students, staff,
    // events, stories — and any future sub-tree, with no rule churn.
    //
    // Support attachments are the sole exclusion; they are reachable only via
    // the owner-scoped block above. Staff read them through the panel, which
    // uses the Admin SDK and hands out 5-minute signed URLs.
    match /schools/{schoolId}/{area}/{rest=**} {
      allow read: if request.auth != null
                  && request.auth.token.school_id == schoolId
                  // .lower() is NOT decoration. A case-sensitive compare lets
                  // schools/{id}/Support/... slip the exclusion and be read
                  // school-wide, silently reopening the hole this block exists
                  // to close. Parents cannot write there (role-excluded from the
                  // broad write arm, and the owner-scoped block below requires
                  // literal lowercase), but any other authenticated role could.
                  && area.lower() != 'support';
    }

    // ─── L6b: READ for files directly under schools/{schoolId}/ ────────────
    // L6a needs at least one sub-folder segment. Anything written straight into
    // the school root would otherwise lose the read it had before this change.
    match /schools/{schoolId}/{file} {
      allow read: if request.auth != null
                  && request.auth.token.school_id == schoolId;
    }

    // ─── L7: STUDENTS (Sis.php:1601 lowercase variant) ──────────────────
    // Path:  Students/{schoolId}/{userId}/docs/{docLabel}
    // Distinct from G2 below (G2 uses {schoolName}/Students/...). Both
    // schemes are used by Sis.php for the same logical student (verified
    // at Sis.php:3263-3264 where both are deleted in tandem).
    match /Students/{schoolId}/{userId}/{path=**} {
      allow read:  if request.auth != null
                   && request.auth.token.school_id == schoolId;
      allow write: if request.auth != null
                   && request.auth.token.school_id == schoolId;
    }

    // ════════════════════════════════════════════════════════════════════
    //  LEGACY PATH SCHEMES — pre-2026-06-13 files only
    //  (See CRITICAL INVARIANT block at top of file.)
    // ════════════════════════════════════════════════════════════════════
    // KEEP these blocks: existing files uploaded before the 2026-06-13
    // canonical cutover still live at these paths and their stored download
    // URLs must keep resolving. NEW writes no longer land here — they all go
    // to schools/{schoolId}/... (L6 above). The L7 Students/{schoolId}/ and
    // G1–G3 {schoolName}/ blocks are frozen legacy, not active write targets.
    // The blocks below cover the older path scheme where the school
    // identifier is the FIRST path segment rather than nested under
    // 'schools/'. Each block uses an explicit literal second segment
    // ('Staff', 'Students', 'Events', 'school_logos', 'holidays',
    // 'academic') so it doesn't overlap with the modern lowercase-prefix
    // patterns above (which use distinct literal first segments).

    // ─── G1: Staff profile pics + documents ─────────────────────────────
    // Paths written by Staff.php (admin web panel):
    //   {schoolName}/Staff/{staffId}/Profile_pic/{filename}
    //   {schoolName}/Staff/{staffId}/Profile_pic/thumbnail/{filename}
    //   {schoolName}/Staff/{staffId}/Documents/{filename}
    //   {schoolName}/Staff/{staffId}/Documents/thumbnail/{filename}
    match /{schoolName}/Staff/{path=**} {
      allow read:  if request.auth != null
                   && request.auth.token.school_id == schoolName;
      allow write: if request.auth != null
                   && request.auth.token.school_id == schoolName;
    }

    // ─── G2: Student profile pics + documents ──────────────────────────
    // Paths written by Sis.php:
    //   {schoolName}/Students/{combinedClassPath}/{studentId}/Profile_pic/...
    //   {schoolName}/Students/{combinedClassPath}/{studentId}/Documents/...
    //   (plus thumbnail subfolders)
    match /{schoolName}/Students/{path=**} {
      allow read:  if request.auth != null
                   && request.auth.token.school_id == schoolName;
      allow write: if request.auth != null
                   && request.auth.token.school_id == schoolName;
    }

    // ─── G3: Event gallery media ────────────────────────────────────────
    // Path written by Schools.php gallery upload flow:
    //   {schoolName}/Events/Media/{eventId}/{img|vid}_{ts}_{rand}.{ext}
    // Frozen legacy path — no NEW writes land here (active gallery writes go
    // to galleryMedia/... L2 and the PHP-admin-SDK schools/{schoolId}/events
    // tree L6). Harden defensively with the same non-staff block + 50 MiB cap
    // as L2 so any residual direct client write can't be abused (audit H2).
    match /{schoolName}/Events/{path=**} {
      allow read:   if request.auth != null
                    && request.auth.token.school_id == schoolName;
      allow create, update:
                    if request.auth != null
                    && request.auth.token.school_id == schoolName
                    && !(request.auth.token.role in
                         ['Student','student','Parent','parent','Guardian','guardian'])
                    && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if request.auth != null
                    && request.auth.token.school_id == schoolName;
    }

    // ─── G4: Legacy school logos (Schools.php::add_school) ──────────────
    // Path written via Common_model::handleFileUpload:
    //   {schoolName}/school_logos/school_logos.jpg
    // Coexists with the newer L6 schools/{schoolId}/logo/... scheme.
    match /{schoolName}/school_logos/{path=**} {
      allow read:  if request.auth != null
                   && request.auth.token.school_id == schoolName;
      allow write: if request.auth != null
                   && request.auth.token.school_id == schoolName;
    }

    // ─── G5: Legacy holidays document (Schools.php::add_school) ─────────
    // Path written via Common_model::handleFileUpload:
    //   {schoolName}/holidays/holidays.{ext}
    // Coexists with the newer L6 schools/{schoolId}/holidays/... scheme.
    match /{schoolName}/holidays/{path=**} {
      allow read:  if request.auth != null
                   && request.auth.token.school_id == schoolName;
      allow write: if request.auth != null
                   && request.auth.token.school_id == schoolName;
    }

    // ─── G6: Legacy academic document (Schools.php::add_school) ─────────
    // Path written via Common_model::handleFileUpload:
    //   {schoolName}/academic/academic.{ext}
    // Coexists with the newer L6 schools/{schoolId}/academic/... scheme.
    match /{schoolName}/academic/{path=**} {
      allow read:  if request.auth != null
                   && request.auth.token.school_id == schoolName;
      allow write: if request.auth != null
                   && request.auth.token.school_id == schoolName;
    }

    // No catch-all match block. Any path not matched above defaults to
    // deny-by-default. New features adding Storage paths MUST add a
    // corresponding match block (and update the smoke-test matrix) before
    // deploying their client code. Phase B will add role-tier gating and
    // Phase C will add MIME allowlists and size caps on top of these
    // tenant-isolation blocks.
  }
}
