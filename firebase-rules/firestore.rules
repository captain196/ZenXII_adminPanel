rules_version = '2';

// Firestore Security Rules for SchoolSync
//
// PHP backend uses service account (bypasses these rules entirely).
// These rules protect DIRECT client access from Android apps.
//
// Principle: deny-all by default. Only explicitly listed collections are accessible.
// Every read requires: authenticated + matching schoolId
// Every write requires: authenticated + correct role + matching schoolId

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    // ─────────────────────────────────────────────────────────────
    // H-LIFECYCLE H1 — server-side tenant access gate.
    //
    // Double-gates client access on (a) schoolControl.lifecycle.state
    // (the canonical billing/access state from B2.3.2) AND (b)
    // schools.adminDisabled.value (the operational SA toggle).
    // Defense in depth: even if backend fan-out drifts and the two
    // surfaces disagree, the MORE RESTRICTIVE wins — i.e. either
    // suspension signal denies.
    //
    // Allow-list states:
    //   active         — paid, normal
    //   trialing       — trial customer, still active
    //   expiring_soon  — active with upcoming renewal
    //   grace          — paid customer in grace period
    // Deny states:
    //   past_due, suspended, expired
    //
    // Cost: 2 get()s per rule eval. Firestore caches get() results
    // PER REQUEST so a query reading N docs incurs +2 reads total
    // (not 2N). Latency: ~10-25ms added per Firestore op. Acceptable
    // at current scale; re-evaluate at >1000 tenants.
    //
    // Bypass: PHP backend writes via service account bypass rules
    // entirely (Admin SDK does not evaluate these rules), so billing,
    // audit logs, and SA-side writes continue to land on suspended
    // tenants — intentional for revenue retention + compliance.
    //
    // Mobile/client clients SUBSCRIBE to tenantPublic/{schoolId} to
    // detect lifecycleState transitions in seconds — see H1.5 (the
    // backend mirror) + H2/H3 (reactive logout in Parent + Teacher).
    function tenantActive(schoolId) {
      let ctrl = get(/databases/$(database)/documents/schoolControl/$(schoolId));
      let sch  = get(/databases/$(database)/documents/schools/$(schoolId));
      return ctrl != null
        && ctrl.data.lifecycle.state in [
          'active', 'trialing', 'expiring_soon', 'grace'
        ]
        && (
          sch == null
          || !('adminDisabled' in sch.data)
          || sch.data.adminDisabled.value != true
        );
    }

    // Match schoolId field in document to school_id in auth token.
    // Supports both field names: schoolId (new) and schoolCode (legacy).
    // For non-existent docs (get), resource is null — allow if authenticated.
    // Use isSameSchoolStrict() instead on collections where existence
    // probing would leak cross-tenant information (e.g. homework module).
    function isSameSchool() {
      return isAuth()
        && tenantActive(request.auth.token.school_id)
        && (
          resource == null ||
          resource.data.schoolId == request.auth.token.school_id ||
          resource.data.schoolCode == request.auth.token.school_id
        );
    }

    // Stricter variant of isSameSchool() that fails closed when the
    // requested document does not exist. Use ONLY for collections where
    // a non-existent docId should NOT leak existence/non-existence to
    // cross-tenant probers — i.e. homework-module reads where document
    // IDs are constructed by trusted writers with collision-safe entropy:
    //   • Admin PHP — Homework.php derives hwId as
    //     {school_name}_{ms_timestamp}_{8-hex-random} (Finding #8).
    //   • Teacher Android — HomeworkFirestoreRepository.mintHwId() uses
    //     the same {school}_{ms}_{8-hex-random} format (entropy hardening
    //     2026-05-15, parity with admin).
    //   • Submission / teacherMark IDs remain {hwId}_{studentId}.
    // This rule does NOT enforce ID format (the {docId} wildcard matches
    // anything); the comment documents the shape downstream tooling and
    // forensic queries can assume.
    //
    // Trade-off: client .get() of a non-existent doc returns
    // PERMISSION_DENIED instead of success-with-empty. Callers MUST
    // wrap such reads in try/catch and treat PERMISSION_DENIED as
    // "not found". Parent app's getSubmissionStatus() and
    // getTeacherMark() already do this; Teacher app's reviewOrMark
    // transaction was patched 2026-05-14 to catch PERMISSION_DENIED
    // inside the txn lambda for the same reason.
    function isSameSchoolStrict() {
      return isAuth()
        && tenantActive(request.auth.token.school_id)
        && resource != null
        && (
          resource.data.schoolId == request.auth.token.school_id ||
          resource.data.schoolCode == request.auth.token.school_id
        );
    }

    // Finding #6 / Option B1 hardening 2026-05-14: explicit non-empty
    // schoolId guard closes the latent edge case where a user with a
    // missing/empty JWT `school_id` claim could otherwise pass this rule
    // by sending a write payload with empty `schoolId` field — the empty
    // == empty comparison would have evaluated true under the prior
    // helper. The new guard hard-rejects writes whose payload carries
    // no schoolId, regardless of JWT claim state.
    //
    // Read-side behavior is INTENTIONALLY UNTIGHTENED — isSameSchool()
    // continues to accept resource.data.schoolCode as a legacy fallback
    // so existing schoolCode-only documents (produced by PHP backend
    // Entity_firestore_sync syncStaff/syncExam/syncExamSchedule/
    // syncAttendance — service-account writes that bypass these rules)
    // remain readable. Canonicalizing those PHP write paths is tracked
    // as a separate technical-debt remediation, not in this scope.
    //
    // Backward-compat for legacy writers that still send schoolCode
    // (none observed in current Admin/Teacher/Parent code paths) is
    // preserved via the `||` clause: a write carrying schoolCode
    // (and no schoolId) would still fail the new non-empty guard, but
    // such writes do not exist in the current canonicalized client code.
    function isSameSchoolWrite() {
      return isAuth()
        && tenantActive(request.auth.token.school_id)
        && request.resource.data.schoolId is string
        && request.resource.data.schoolId.size() > 0
        // D7 (2026-07-12): schoolCode write-arm removed — every current
        // Admin/Teacher/Parent write sets schoolId (audited: no schoolId-less
        // write exists), so the spoofable `schoolCode == school_id` fallback
        // (F-2) was vestigial on the write path. Read-side isSameSchool()/
        // isSameSchoolStrict() KEEP their schoolCode arm to still serve legacy
        // schoolCode-only documents on reads.
        && request.resource.data.schoolId == request.auth.token.school_id;
    }

    // FOLD: after the Admin→staff fold a demoted admin's token role is their
    // NOMINAL label (e.g. "HR Manager"), no longer "Admin", so the legacy role
    // arm alone would drop them from all isAdmin()-gated writes. The second arm
    // recognises them via the server-maintained staffCapabilities.admin flag
    // (set by the CF when the resolved roles include ROLE_ADMIN / a bypass role).
    // Fail-safe: caps doc absent → falls back to the role arm (no new lockout).
    // No per-gate edits — all 77 isAdmin() call sites inherit this transparently.
    function isAdmin() {
      return isAuth()
        && tenantActive(request.auth.token.school_id)
        && (
          // True admin LABELS only. 'Principal' REMOVED (audit C3): a Principal is
          // not an admin by default, so trusting the bare label let a panel-
          // restricted Principal write freely to staff/students/sections via the
          // client SDK (escalation-by-label). A Principal who IS meant to be an
          // admin gets ROLE_ADMIN → the CF sets staffCapabilities.admin==true and
          // the capability arm below grants them — so no legitimate admin loses
          // access, but the unearned label grant is gone.
          request.auth.token.role in ['Admin', 'admin', 'School Super Admin', 'school_super_admin', 'Super Admin', 'super_admin']
          || (
            exists(/databases/$(database)/documents/staffCapabilities/$(request.auth.uid))
            && get(/databases/$(database)/documents/staffCapabilities/$(request.auth.uid)).data.admin == true
          )
        );
    }

    // Staff = any authenticated, same-school user who is NOT a student or
    // parent. This is EXCLUSION-based on purpose: staff role titles are
    // free-form (schools type "Senior Teacher", "PGT English", "TGT Hindi",
    // "Librarian", "Clerk", "Lab Assistant", "PET", or leave it blank), so a
    // hardcoded allow-list silently locked ~half of real staff out of every
    // isStaff()-gated write (stories, homework, events, marks…). Only the
    // student/parent roles are non-staff, and those are the closed set the
    // apps mint, so excluding them is both correct and future-proof. Custom
    // claims are server-signed, so a parent cannot strip their role to
    // impersonate staff. Mirrors the "no RBAC gating on the mobile apps"
    // design — scoping stays at the assignment/linkage-doc layer.
    function isStaff() {
      return isAuth()
        && tenantActive(request.auth.token.school_id)
        && !(request.auth.token.role in ['Student', 'student', 'Parent', 'parent', 'Guardian', 'guardian']);
    }

    function isSuperAdmin() {
      return isAuth() && request.auth.token.role in ['Super Admin', 'super_admin'];
    }

    // ─── Unified Staff RBAC — per-module capability lookup ────────────
    // staffCapabilities/{uid} (uid == staffId) is the server-maintained module
    // set written by the staffCapabilities Cloud Function (mirrors the PHP
    // resolve_role_access union resolver). hasCapability() FAILS OPEN when the
    // doc is absent — a staff member who predates the CF or hasn't been backfilled
    // is allowed, so ADDING a capability gate can never lock out an un-migrated
    // account. It only denies once the doc EXISTS and omits the module. These
    // gates are added ONLY to the isStaff() WRITE arms of app-facing modules —
    // never to read arms, parent/student arms, or shared helpers.
    function staffCapsExist() {
      return exists(/databases/$(database)/documents/staffCapabilities/$(request.auth.uid));
    }
    function hasCapability(module) {
      return !staffCapsExist()
        || get(/databases/$(database)/documents/staffCapabilities/$(request.auth.uid))
             .data.get('modules', []).hasAny([module]);
    }
    function rbacLevelRank(l) {
      return l == 'manage' ? 3 : (l == 'edit' ? 2 : 1);
    }
    // Like hasCapability but ALSO enforces the graded level (view < edit < manage).
    // Fail-open when the caps doc is absent (pre-rollout). Used to gate the WRITE
    // actions of BASELINE modules (Stories/Events/Communication) — a view-only
    // baseline holder can read/participate but not moderate or delete.
    function hasCapabilityLevel(module, level) {
      return !staffCapsExist()
        || (
          get(/databases/$(database)/documents/staffCapabilities/$(request.auth.uid))
            .data.get('modules', []).hasAny([module])
          && rbacLevelRank(
               get(/databases/$(database)/documents/staffCapabilities/$(request.auth.uid))
                 .data.get('levels', {}).get(module, 'view')
             ) >= rbacLevelRank(level)
        );
    }

    // Per-student fee collections need to differentiate "this parent
    // accessing their own child's data" from "this parent accessing
    // some other student's data". Parent-app auth uses the student's
    // userId as the Firebase auth UID, so we check studentId against
    // request.auth.uid.
    //
    // Supports camelCase `studentId` (canonical) and snake_case
    // `student_id` (legacy — to be purged after migration). Using
    // .get(key, '') with a default avoids rule-eval errors when
    // either field is absent.
    //
    // For non-existent docs (resource == null), we can't compare —
    // allow if authenticated so a missing doc returns null cleanly
    // instead of 403. Same-school check is applied by callers.
    function isOwnStudent() {
      return isAuth() && (
        resource == null ||
        resource.data.get('studentId', '')  == request.auth.uid ||
        resource.data.get('student_id', '') == request.auth.uid
      );
    }

    // A parent authenticates as ONE child (auth.uid == child A's studentId) but
    // can switch the active child in-app and then request child B's docs. Allow
    // when the requested doc's student is LINKED to the same parent — the
    // students doc's parentDbKey must equal the parent's `parent_db_key` claim
    // (server-signed, non-forgeable). Mirrors the /submissions sibling fix so
    // multi-child households aren't 403'd on a linked sibling's attendance.
    function isLinkedChild() {
      return isAuth()
        && resource != null
        && request.auth.token.get('parent_db_key', '') != ''
        && get(/databases/$(database)/documents/students/$(resource.data.get('schoolId','') + '_' + resource.data.get('studentId',''))).data.get('parentDbKey','') == request.auth.token.parent_db_key;
    }

    // Convenience: read is allowed when caller is staff (sees all
    // school records) OR the same school AND the doc belongs to
    // their own student. The `resource == null` arm covers parents
    // calling `get()` on a doc that doesn't exist — Firestore evaluates
    // the rule against `null`, and we shouldn't punish a missing read.
    function isStaffOrOwnStudent() {
      return isStaff() || (isSameSchool() && isOwnStudent());
    }

    // ── Schools (read-only for apps; SA-only client write) ──────
    // Wave B2.2-F (2026-05-30): write narrowed isAdmin() -> isSuperAdmin().
    // Blast-radius confirmed regression-free (no client of any role writes
    // schools — Parent + Teacher apps READ-only; PHP panels via Admin SDK
    // bypass these rules entirely). All schools writers route through the
    // service account; the narrowing removes an unused authorization.
    //
    // H-LIFECYCLE H1 (2026-05-31): read also requires tenantActive(docId)
    // — i.e. mobile apps cannot read their own school doc when the
    // tenant is suspended. Combined with the broader gate composed
    // into isSameSchool*/isAdmin/isStaff, this covers ~31 collections.
    match /schools/{docId} {
      allow read: if isAuth()
        && tenantActive(docId)
        && (
          resource.data.schoolId == request.auth.token.school_id ||
          docId == request.auth.token.school_id
        );
      allow write: if isSuperAdmin();
    }

    // ── Sections ─────────────────────────────────────────────────
    match /sections/{docId} {
      allow read: if isSameSchool();
      allow write: if isAdmin();
    }

    // ── Students ─────────────────────────────────────────────────
    match /students/{docId} {
      allow read: if isSameSchool();
      allow write: if isAdmin();
      // Phase A — students can clear their own mustChangePassword flag
      // after their first password change. Restricted to two fields so
      // a student can't escalate (e.g. change Class, Section, Status).
      // Doc id is `{schoolId}_{studentId}` and auth.uid == studentId.
      allow update: if isSameSchool()
                    && request.auth.uid == resource.data.studentId
                    && request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['mustChangePassword', 'updatedAt']);
      // Language preference — self-service, mirrored from the Parent app so
      // push can be composed in the parent's language and a reinstall or
      // account switch can restore it. The app renders from a device-local
      // preference, so this write is best-effort; it is the SERVER's copy.
      //
      // A SEPARATE clause on purpose: widening the mustChangePassword
      // allowlist above would let a student send both fields in one write,
      // and that allowlist needs to stay byte-narrow.
      allow update: if isSameSchool()
                    && request.auth.uid == resource.data.studentId
                    && request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['prefLang', 'updatedAt'])
                    && request.resource.data.prefLang is string
                    && request.resource.data.prefLang.size() <= 8;
    }

    // ── Staff ────────────────────────────────────────────────────
    // The staff doc is same-school readable (parents/students read it for teacher
    // search + PTM), so it must hold ONLY non-sensitive fields (name, role, photo,
    // department, phone). Sensitive PII (PAN/Aadhaar/PF/ESI/salary/bank) and
    // credentials live in staffPrivate below — see audit C1.
    match /staff/{docId} {
      allow read: if isSameSchool();
      allow write: if isAdmin();
    }

    // ── Staff Private (audit C1) ─────────────────────────────────
    // Sensitive PII (PAN/Aadhaar/PF/ESI/salary/bank) that the readable staff doc
    // no longer holds. OWNER-ONLY read: a staff member may read their OWN private
    // doc (their My-Profile screen shows their PAN/bank) — docId is
    // `{schoolId}_{staffId}` and uid == staffId under synthetic-email auth, so the
    // owner check is exact. Peers, parents and students are denied (the whole point
    // of C1). Writes are server-only: the PHP backend (service account) bypasses
    // rules, so HR/payroll writes + the migration still work; no client may write.
    match /staffPrivate/{docId} {
      allow read: if isAuth()
                  && docId == (request.auth.token.school_id + '_' + request.auth.uid);
      allow write: if false;
    }

    // ── Subjects ─────────────────────────────────────────────────
    match /subjects/{docId} {
      allow read: if isSameSchool();
      allow write: if isAdmin();
    }

    // ── Subject Assignments (canonical: who teaches what to which class/section) ──
    match /subjectAssignments/{docId} {
      allow read: if isSameSchool();
      allow write: if isAdmin();
    }

    // ── Attendance (Phase 3 — clients READ ONLY; backend writes via service account)
    //
    // Phase 1+2 moved every attendance writer behind the PHP backend
    // (`/attendance/save`, `/attendance/correction/decide`, etc.). The
    // service account bypasses these rules entirely; client SDKs
    // (Teacher app, Parent app) get hard-deny on writes.
    //
    // Read scoping:
    //   • Staff (Teacher / Admin / Principal …) → school-wide read.
    //     Per-class enforcement is done in PHP (`_teacher_can_access`).
    //     Tightening to per-class at the rule layer would require
    //     custom claims listing each teacher's classes — deferred.
    //   • Parent → only own child's docs (auth.uid == studentId).
    match /attendance/{docId} {
      allow read:  if (isStaff() && isSameSchool())
                   || (isAuth() && isSameSchool() && (isOwnStudent() || isLinkedChild()));
      allow write: if false;   // PHP service account bypasses
    }

    // ── Attendance Summary (Phase 3 — same scoping as attendance) ─
    match /attendanceSummary/{docId} {
      allow read:  if (isStaff() && isSameSchool())
                   || (isAuth() && isSameSchool() && (isOwnStudent() || isLinkedChild()));
      allow write: if false;
    }

    // ── Attendance Locks (Phase 3 — staff read for stage display) ─
    // Parents do not see lock state; only staff render the stage badge.
    match /attendanceLocks/{docId} {
      allow read:  if isStaff() && isSameSchool();
      allow write: if false;
    }

    // ── Correction Requests (Phase 3 — teacher own / admin all) ───
    // Teachers may only read requests THEY filed (requestedBy == auth.uid).
    // Admins/Principals see every request in the school.
    match /attendanceCorrectionRequests/{docId} {
      allow read:  if (isAdmin() && isSameSchool())
                   || (isStaff() && isSameSchool() && resource.data.requestedBy == request.auth.uid);
      allow write: if false;
    }

    // ── Staff GPS-attendance Regularization requests (staff self-file) ─
    // The Teacher app writes ONE doc per date DIRECTLY here on submit (no
    // backend round-trip). A staff member may create + read ONLY their own
    // requests, hard-bound to their own uid + school + personType, and only
    // in the initial 'pending' state. Admin/HR read every request in-school.
    // Approve/reject transitions are applied by the PHP service account
    // (which bypasses rules), so clients can never update/delete — this is
    // what makes the client-supplied staffId safe: it MUST equal auth.uid,
    // the same identity the server-authoritative punch/me flow derives from
    // the token. Without this block the collection hit the default-deny
    // catch-all and every app submit failed with PERMISSION_DENIED.
    match /attendanceRegularizations/{docId} {
      allow read:   if (isAdmin() && isSameSchool())
                    || (isStaff() && isSameSchool() && resource.data.staffId == request.auth.uid);
      allow create: if isStaff()
                    && request.resource.data.schoolId == request.auth.token.school_id
                    && request.resource.data.staffId == request.auth.uid
                    && request.resource.data.personType == 'staff'
                    && request.resource.data.status == 'pending'
                    // A staff member may only request Present (P) or Half-Day (M).
                    // Blocks a modified client from self-requesting Holiday/Leave/
                    // Weekly-off/Extra-pay marks that carry payroll value.
                    && request.resource.data.requestedStatus in ['P', 'M'];
      allow update, delete: if false;   // PHP service account applies decisions
    }

    // ── Audit Log (Phase 3 — admin only; never writable by clients) ─
    match /attendanceAuditLog/{docId} {
      allow read:  if isAdmin() && isSameSchool();
      allow write: if false;
    }

    // ── Homework ──────────────────────────────────────────────────
    //
    // Finding #26 (deferred, 2026-05-14): rule-layer per-class teacher ACL
    // is NOT enforced on /homework, /submissions, or /teacherMarks. Any
    // same-school staff member can read/write across classes via direct
    // Firestore SDK calls, bypassing the Teacher app's UI assignment
    // scoping and the PHP backend's _teacher_can_access check. Current
    // mitigations:
    //   • Teacher app UI shows only assigned classes (loadAssignedClasses)
    //   • PHP _teacher_can_access (Academic.php:665) gates PHP endpoints
    //   • Audit logging captures cross-class access patterns
    // Rule-layer enforcement deferred because the canonical subjectAssignments
    // docId format ({schoolId}_{session}_{className}_{section}_{subjectCode})
    // does not include teacherId, and the homework doc lacks `session` and
    // `subjectCode` fields needed to compose a rule-side get(). Revisit when
    // either (a) JWT assignment-claim infrastructure exists, or (b) the
    // subjectAssignments schema is redesigned for cheap teacher-keyed lookups.
    //
    match /homework/{docId} {
      allow read:   if isSameSchoolStrict();
      // Unified RBAC: teacher-create requires the Homework capability (fail-open
      // until the caps doc exists — see hasCapability). The parent submissionCount
      // arm below is untouched. Same one-line pattern applies to the other
      // app-facing WRITE arms (Stories, Events/galleryMedia, studentFlags, marks,
      // lessonPlans) — to be composed per-module before the rollout enforces.
      allow create: if isStaff() && isSameSchoolWrite() && hasCapability('Homework');

      // Staff path — edit/close homework. Finding #26 hardening (2026-07-01):
      // restrict to the OWNING teacher (teacherId == auth.uid) OR an admin /
      // principal (isAdmin). Previously ANY same-school staff could edit ANY
      // homework. Admin-panel edits run via the Admin SDK (rules bypassed), so
      // this only constrains client (app) writes; the Teacher app writes
      // teacherId == the teacher's uid.
      allow update: if isStaff() && isSameSchool()
        && (resource.data.teacherId == request.auth.uid || isAdmin());

      // Parent path — may ONLY increment submissionCount by exactly +1
      // (atomic counter bump on first submission). All other field changes
      // are rejected, decrements are blocked, and arbitrary increments are
      // capped — without the +1 cap a tampered client could push the
      // counter to any value to fake high submission rates.
      //
      // Finding #2 (deferred, 2026-05-14): this counter is denormalized and
      // client-mutable. Audit's race-condition claim was INCORRECT — Firestore
      // transactions correctly serialize the legitimate submitHomework flow
      // (HomeworkFirestoreRepository.kt:226-261). Real adjacent issues:
      //   (2A) modified APK can call this update repeatedly without an
      //        actual /submissions create — counter inflates 1/click
      //   (2B) /submissions delete (teacher cascade) does NOT decrement —
      //        counter overcounts after any deletion
      //   (2C) Admin Homework.php:1007 overwrites counter to 0 on certain
      //        updates (tracked separately as audit Finding #37)
      // submissionCount is BEST-EFFORT denormalized display only — no
      // policy/authorization decisions key off it. Anything requiring
      // accuracy must query /submissions directly. Unified remediation
      // with Finding #37 deferred to a future denormalization-hardening
      // phase that introduces server-side authoritative aggregation
      // (Cloud Function trigger / reconciler — both currently out of scope).
      //
      // Finding #7 (closed-as-duplicate, 2026-05-14): the audit's
      // "submissionCount corruption / cross-flow inconsistency" finding
      // decomposes entirely into (#2A, #2B, #37) above and Finding #4
      // (4a/4d already fixed; 4c deferred). No materially distinct
      // surface — closure-by-reference. See stabilization-ledger entry.
      allow update: if isAuth() && isSameSchool() && !isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['submissionCount'])
        && request.resource.data.submissionCount == resource.data.submissionCount + 1;

      // Finding #26 hardening (2026-07-01): only the owning teacher or an
      // admin/principal can delete homework (was: any same-school staff).
      allow delete: if isStaff() && isSameSchool()
        && (resource.data.teacherId == request.auth.uid || isAdmin());
    }

    // ── Homework Submissions ─────────────────────────────────────
    match /submissions/{docId} {
      // Finding #14 2026-05-14: add parent-side cross-student protection.
      // Staff continue to read school-wide (needed for marking workflows);
      // parents are now scoped to their own child (auth.uid == studentId).
      // Pattern mirrors /attendance read rule at line 192-194. Composing
      // with isSameSchoolStrict() preserves Finding #5 non-existent-doc
      // protection. Parent app's existing try/catch around read calls
      // (getSubmissionStatus / getSubmissionsForStudent / observeSubmissions)
      // absorbs the new PERMISSION_DENIED for cross-student requests
      // gracefully — no client coordination required.
      allow read:   if isSameSchoolStrict() && (isStaff() || isOwnStudent());
      // Use isSameSchoolWrite() (checks request.resource.data.schoolId),
      // not isSameSchool() — on create, resource is null so isSameSchool()
      // returns true unconditionally for any authed user, letting a
      // tampered client write `schoolId: "OTHER_SCHOOL"` while still
      // passing the studentId == auth.uid check with their own UID.
      // Finding #1 / Fix 1A 2026-05-14: enforce server-side timestamp on
      // create. Prior rule trusted client-provided `submittedAt`; a modified
      // APK could write a backdated Timestamp literal to fake an on-time
      // submission. Legitimate Parent app already writes
      // `firestoreService.serverTimestamp()` (HomeworkFirestoreRepository.kt:219)
      // which the server replaces with `request.time` at commit, so this
      // equality check is a no-op for legitimate clients and a hard reject
      // for backdating attempts. Hard deadline (dueDate) rejection remains
      // deferred — see Fix 1C deferral note below.
      // Sibling-submit fix (2026-07-01): a parent authenticates as ONE child
      // but can switch the active child in-app (user.userId changes; auth.uid
      // does not). Allow a submission for the authenticated child OR for any
      // child LINKED to the same parent — the student doc's parentDbKey must
      // equal the parent's `parent_db_key` claim. The key must be non-empty so
      // two unlinked students with a blank key can't cross-submit; get()
      // securely verifies linkage server-side (client can't forge it).
      allow create: if isAuth()
        && isSameSchoolWrite()
        && request.resource.data.submittedAt == request.time
        && (
             request.auth.uid == request.resource.data.studentId
             || (
                  request.auth.token.parent_db_key is string
                  && request.auth.token.parent_db_key.size() > 0
                  && get(/databases/$(database)/documents/students/$(request.resource.data.schoolId + '_' + request.resource.data.studentId)).data.parentDbKey == request.auth.token.parent_db_key
                )
           );

      // Parent (non-staff) update path — limited to work-in-progress
      // fields, and status (if changed) must be "submitted".
      //
      // Finding #1 / Fix 1B-a 2026-05-14: when `submittedAt` is in the
      // affected-keys set (legitimate re-submission flow refreshes it via
      // serverTimestamp), require the new value to equal request.time. This
      // closes the parallel backdating exploit on the update path while
      // preserving Parent app's normal re-submission semantics (which uses
      // SetOptions.merge() with `firestoreService.serverTimestamp()`).
      //
      // Finding #17 2026-05-14: grading-finality guard. Once a submission's
      // status advances beyond 'submitted' (i.e. teacher set it to
      // 'reviewed' / 'graded'), parents can no longer overwrite text /
      // files / submittedAt / status. Without this clause, a modified APK
      // (or direct-API call) could silently swap the submitted content
      // under an existing teacher grade and reset status to 'submitted',
      // creating audit-trail confusion and content-vs-grade mismatch
      // (the teacher's score/remark/reviewedBy/reviewedAt are already
      // protected by the field-whitelist above and remain preserved, but
      // they'd end up referring to swapped content).
      //
      // Legitimate re-grade workflow when needed: teacher deletes the
      // submission (allow delete at line 289 below) — parent then re-
      // creates via the CREATE rule above. This explicit two-step
      // replaces what was previously a silent overwrite.
      //
      // Parent UI already hides the re-submit button when isCompleted()
      // returns true (HomeworkScreen.kt:1033), so this rule tightening
      // reinforces the existing client discipline at the server layer
      // and only affects modified-APK / direct-API bypass attempts.
      // 2026-07-01 (co-fix with Finding #11): also allow re-submission when
      // the teacher explicitly bounced the work back as 'incomplete' or
      // 'pending'. The post-condition below still forces the new status to
      // 'submitted', so the parent can only push it forward (redo), never
      // sideways. 'reviewed'/'graded'/'complete' remain terminal — not in
      // this list, so the grading-finality guard (Finding #17) still holds.
      allow update: if isAuth() && isSameSchool() && !isStaff()
        && resource.data.get('status', '') in ['', 'submitted', 'incomplete', 'pending']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['text', 'files', 'submittedAt', 'status'])
        && (
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
             || request.resource.data.status == 'submitted'
           )
        && (
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['submittedAt'])
             || request.resource.data.submittedAt == request.time
           );

      // Teacher update path — grading fields only; status (if changed)
      // must be one the Teacher UI can actually pick.
      //
      // Finding #11 RESOLVED (2026-07-01): the Teacher UI dropdown
      // (HomeworkTeacherScreen.kt) offers 5 status options
      // ["pending", "submitted", "reviewed", "incomplete", "complete"];
      // reviewOrMark()'s safeStatus whitelist already constrains the
      // written value to exactly this set (+ legacy "graded"). Previously
      // this rule only accepted 'reviewed'/'graded', so a teacher picking
      // complete/incomplete/pending on a student who HAD submitted got
      // PERMISSION_DENIED (while the same pick on a non-submitter wrote to
      // /teacherMarks, which has no whitelist — inconsistent behaviour).
      // The whitelist is now the full UI set. The Finding #17 UX-gap
      // concern (re-showing Parent's submit button while the parent update
      // rule denies re-submission) is closed in the SAME deploy by adding
      // 'incomplete'/'pending' to the parent update pre-condition below —
      // so a teacher marking "incomplete"/"pending" now lets the parent
      // re-submit (status back to 'submitted'), while 'complete'/'reviewed'
      // remain terminal (isCompleted() hides the button).
      allow update: if isStaff() && isSameSchool()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['score', 'reviewedBy', 'reviewedAt', 'remark', 'status'])
        && (
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
             || request.resource.data.status in ['reviewed', 'graded', 'complete', 'incomplete', 'submitted', 'pending']
           );

      allow delete: if isStaff() && isSameSchool();
    }

    // ── Teacher Marks (recorded grade for students who didn't submit) ─
    match /teacherMarks/{docId} {
      // Finding #14 2026-05-14: add parent-side cross-student protection.
      // Same composition as /submissions above — staff read school-wide
      // (needed for grading dashboards), parents see only their own child
      // (auth.uid == studentId). Parent app's getTeacherMark() and
      // getTeacherMarksForStudent() already catch exceptions and return
      // null/empty on denial, so no client coordination is required.
      allow read:   if isSameSchoolStrict() && (isStaff() || isOwnStudent());
      allow create: if isAuth() && isStaff() && isSameSchoolWrite();
      allow update: if isStaff() && isSameSchool();
      allow delete: if isStaff() && isSameSchool();
    }

    // ── Lesson Plans (Phase 6/7 — Academic Planner) ──────────────
    // Visible to all same-school users so parents can see today's
    // lessons for their child's class. Only staff (admin/teacher) can
    // write; admin's PHP service bypasses these rules via service
    // account anyway.
    match /lessonPlans/{docId} {
      allow read:   if isSameSchool();
      allow create: if isStaff() && isSameSchoolWrite() && hasCapability('Academic');
      allow update: if isStaff() && isSameSchool() && hasCapability('Academic');
      allow delete: if isAdmin() && isSameSchool();
    }

    // ── Subject Plan Progress (Phase 8 — per-class counters) ─────
    // Read by same-school (parents see their class's progress strip).
    // Writes only by staff (PHP hook + future Cloud Function via admin
    // SDK; teacher app doesn't write summaries directly).
    match /subjectPlanProgress/{docId} {
      allow read:  if isSameSchool();
      allow write: if isStaff() && (isSameSchoolWrite() || isSameSchool());
    }

    // ── Daily Teacher Monitoring (Phase 8 — admin oversight only) ─
    // Staff-only read: contains per-teacher daily plan counts that
    // parents shouldn't browse across all staff.
    match /dailyTeacherMonitoring/{docId} {
      allow read:  if isStaff() && isSameSchool();
      allow write: if isStaff() && (isSameSchoolWrite() || isSameSchool());
    }

    // ── Academic Audit Log (admin-only) ──────────────────────────
    match /academicAuditLog/{docId} {
      allow read:  if isAdmin() && isSameSchool();
      allow write: if isStaff() && isSameSchoolWrite();
    }

    // 2026-05-15 Phase 3 — legacy permissive /curriculum block removed.
    // The hardened block further down (search for "Phase 0 hardening")
    // supersedes it with strict resource.data.schoolId == auth claim
    // matching and an explicit role whitelist that excludes Accountant.
    // Two `match /curriculum` blocks would have produced an undefined
    // permission outcome under Firestore's rule-union semantics; with
    // this removal, only the hardened block matches and there is no
    // ambiguity.

    // ── Exams ────────────────────────────────────────────────────
    // EXAM-LIFECYCLE Phase 2 (Visibility Hardening): non-staff tenant
    // members (parents/students) may read ONLY Published or Completed
    // exams; Draft is staff-only. Staff (isStaff: Teacher/Admin/etc.)
    // retain full visibility incl. Draft — the Teacher marks-entry
    // picker (getExams) depends on reading Draft exams. The backend
    // (Admin SDK, service account) bypasses rules entirely, so server
    // exam reads via Exam_read are unaffected. tenantActive isolation
    // is inherited through isStaff()/isSameSchool().
    match /exams/{docId} {
      allow read: if isStaff()
                  || (isSameSchool() && resource.data.status in ['Published', 'Completed']);
      allow write: if isAdmin();
    }

    // examVisible — inherit a schedule's visibility from its PARENT exam's
    // status. Staff (Teacher/Admin/…) bypass entirely (they must read Draft
    // exams for marks entry); for non-staff we get() the parent exam doc
    // (id = {schoolId}_{examId}, per Exam_read / syncExamScheduleFull) and
    // require Published/Completed. Cost: one document get() per non-staff
    // schedule read (Firestore caches get()s per request). A missing parent
    // exam → get() null → rule denies (fail-closed), which is correct: a
    // schedule for a non-existent exam is not readable.
    function examVisible(schoolId, examId) {
      return isStaff()
        || get(/databases/$(database)/documents/exams/$(schoolId + '_' + examId)).data.status in ['Published', 'Completed'];
    }

    // ── Exam Schedule ────────────────────────────────────────────
    // RESIDUAL-2 fix (2026-07-08): read WAS `isSameSchool()`, so any
    // same-school parent could directly query examSchedule by a Draft
    // exam's id and read its datesheet out-of-band (no in-app path, but a
    // rules-level leak of scheduling metadata). Now visibility is derived
    // from the parent exam's status via examVisible(): staff read Draft
    // schedules (marks entry — Teacher getExams picker); parents/students
    // read schedules ONLY for Published/Completed exams, matching the
    // /exams rule above. Schedules carry no marks/PII (date/time/maxTotal/
    // passingMarks only). examSchedule docs reliably carry schoolId+examId.
    // Backend (Admin SDK) bypasses rules → Exam_read server reads unaffected.
    match /examSchedule/{docId} {
      allow read: if isStaff()
                  || (isSameSchool() && examVisible(resource.data.schoolId, resource.data.examId));
      allow write: if isAdmin();
    }

    // ── Marks ────────────────────────────────────────────────────
    // CRITICAL-1 (2026-07-08): read was `isSameSchool()` — any same-school
    // parent could read EVERY student's marks (intra-school IDOR). Now
    // staff read school-wide (marks-entry dashboards); parents read only
    // their own child (marks docs carry `studentId`, matched by
    // isOwnStudent() against auth.uid). Uses the canonical isStaffOrOwnStudent()
    // helper (staff OR same-school own-student) — same pattern as feeDemands /
    // submissions, so tenant isolation (tenantActive + schoolId) is enforced too.
    // CRITICAL-2: write was bare `isStaff()` (no tenant binding on the
    // payload) — a staff token from School A could stamp a marks doc with
    // schoolId:"SCH_B". isSameSchoolWrite() pins request.resource.data.schoolId
    // to the caller's claim while keeping legitimate teacher writes working.
    match /marks/{docId} {
      allow read: if isStaffOrOwnStudent();
      allow write: if isStaff() && isSameSchoolWrite() && hasCapability('Results');
    }

    // ── Results ──────────────────────────────────────────────────
    // CRITICAL-1 (2026-07-08): read was `isSameSchool()` — same-school IDOR
    // (any parent reads every student's results). Now staff school-wide /
    // parent own-child only (results docs carry `studentId`).
    // CRITICAL-2: results are Admin-SDK / server-only — the PHP compute +
    // publish flow writes via the service account (bypasses these rules).
    // Client writes were `isStaff()`, letting a teacher forge/overwrite
    // published results. Locked to deny-all for clients, mirroring
    // resultsStaging. INVARIANT: `results` holds ONLY published results;
    // unpublished computed results live in `resultsStaging` (server-only).
    // Read uses the canonical isStaffOrOwnStudent() helper (staff OR same-school
    // own-student), matching feeDemands/submissions and enforcing tenant isolation.
    match /results/{docId} {
      allow read: if isStaffOrOwnStudent();
      allow write: if false;
    }

    // ── Exam Templates (Phase B) ─────────────────────────────────
    // Server-only: per-subject mark-scheme (components/maxMarks) authored by
    // the admin compute flow via Admin SDK (bypasses rules). No client (app)
    // reader consumes templates directly — they read `results`/`examSchedule`.
    // Deny-all intent-lock; Admin SDK writes/reads server-side.
    match /examTemplates/{docId} {
      allow read, write: if false;
    }

    // ── B1 Exam-result infra (server-only; Admin SDK writes) ─────
    // examResultMeta: stale/freshness + publication-dirty signal.
    // marksAudit / resultsAudit: append-only change trails. No client
    // read/write is ever legitimate — deny-all intent-lock (Admin SDK bypasses).
    match /examResultMeta/{docId} { allow read, write: if false; }
    match /marksAudit/{docId}     { allow read, write: if false; }
    match /resultsAudit/{docId}   { allow read, write: if false; }
    // resultsStaging: admin-only staged compute set; promoted to `results` on
    // publish. Never client-visible (parents read `results` only). Server-only.
    match /resultsStaging/{docId} { allow read, write: if false; }

    // ── Fee Structures ───────────────────────────────────────────
    match /feeStructures/{docId} {
      allow read: if isSameSchool();
      allow write: if isAdmin();
    }

    // ── Fee Demands ──────────────────────────────────────────────
    // Per-student doc with `studentId` field — parents see only their
    // own child, staff see everyone in the school. Writes are admin-
    // only AND cross-school-blocked (defense-in-depth; PHP service
    // account bypasses rules entirely, so this only guards direct
    // Firebase-SDK admin writes).
    match /feeDemands/{docId} {
      allow read: if isStaffOrOwnStudent();
      allow create, update: if isAdmin() && isSameSchoolWrite();
      allow delete: if isAdmin() && isSameSchool();
    }

    // ── Fee Receipts ─────────────────────────────────────────────
    match /feeReceipts/{docId} {
      allow read: if isStaffOrOwnStudent();
      allow create, update: if isAdmin() && isSameSchoolWrite();
      allow delete: if isAdmin() && isSameSchool();
    }

    // ── Fee Receipt Allocations (per-demand breakdown of each receipt) ─
    match /feeReceiptAllocations/{docId} {
      allow read: if isStaffOrOwnStudent();
      allow write: if isAdmin();
    }

    // ── Fee Defaulters (per-student dues snapshot) ───────────────
    // Teachers see all students in their school; parents see only
    // their own child's snapshot (drives the dashboard dues banner).
    match /feeDefaulters/{docId} {
      allow read: if isStaffOrOwnStudent();
      allow write: if isAdmin();
    }

    // ── Fee Reminder Log (Phase 8) ───────────────────────────────
    // Records every fee reminder (push/whatsapp/sms/email/log) the
    // admin dispatches. Teacher app reads to show "✓ Reminded" pill
    // on Defaulter rows; parent app reads its own child's history.
    match /feeReminderLog/{docId} {
      allow read: if isStaffOrOwnStudent();
      allow write: if isAdmin();
    }

    // ── Fee Generation Jobs (Phase 10) ───────────────────────────
    // Admin UI writes a job spec; Cloud Function processes it and
    // writes progress updates back to the same doc. Only admins read
    // or write — parents/teachers have no business here.
    match /fee_generation_jobs/{docId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // Student advance (wallet) balances — removed in Phase 9.
    // Tombstone docs (amount=0, migrationReason set) remain in Firestore
    // for audit but no app reads or writes them anymore. Rule omitted so
    // default-deny blocks any accidental reads from old builds.

    // ── Student discounts ────────────────────────────────────────
    match /studentDiscounts/{docId} {
      allow read: if isStaffOrOwnStudent();
      allow write: if isAdmin();
    }

    // ── Scholarship awards ───────────────────────────────────────
    match /scholarshipAwards/{docId} {
      allow read: if isStaffOrOwnStudent();
      allow write: if isAdmin();
    }

    // ── Fee online orders (Razorpay/mock order lifecycle) ────────
    // Historically written with snake_case `student_id`; canonical
    // writers now emit camelCase `studentId`. isOwnStudent() matches
    // either field so in-flight legacy docs continue to work until
    // the snake_case purge is complete (see migration strategy).
    // Parents read only their own order; staff read school-wide.
    match /feeOnlineOrders/{docId} {
      allow read: if isStaffOrOwnStudent();
      allow create, update: if isAdmin() && isSameSchoolWrite();
      allow delete: if isAdmin() && isSameSchool();
    }

    // ── Fee settings (gateway, blocking policy, reminders) ───────
    // Parent reads gateway provider/api_key for the Razorpay SDK.
    match /feeSettings/{docId} {
      allow read: if isSameSchool();
      allow write: if isAdmin();
    }

    // ── Fee audit logs (admin-readable, server-write-only) ───────
    // Audit integrity depends on this being immutable from clients.
    // PHP backend writes via the service account and bypasses rules
    // entirely, so locking writes here costs nothing and prevents a
    // compromised admin token from rewriting the financial trail.
    // (Phase 1 hardening — 2026-05-07.)
    match /feeAuditLogs/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── Fee operational alerts (Phase 3A — server-write-only) ────
    // Populated by the feeOpsSweep Cloud Function (detect-only).
    // Admins read for dashboard surfacing; clients can never write
    // (alert integrity depends on server-only emission). Same
    // isolation pattern as feeAuditLogs but with explicit per-tenant
    // schoolId scoping so cross-school admins cannot see another
    // school's alerts. (Phase 3A — 2026-05-08.)
    match /feeOpsAlerts/{docId} {
      allow read:  if isAdmin() && (
        resource == null ||
        resource.data.schoolId == request.auth.token.school_id
      );
      allow write: if false;
    }

    // ── Server-only fee infrastructure ───────────────────────────
    // These collections are written and read exclusively by the PHP
    // backend (which uses the service account and bypasses these
    // rules). Any direct client access is a bug — deny it explicitly.
    match /feeIdempotency/{docId}    { allow read, write: if false; }
    match /feeLocks/{docId}          { allow read, write: if false; }
    match /feeCounters/{docId}       { allow read, write: if false; }
    match /feeReceiptIndex/{docId}   { allow read, write: if false; }
    match /feeDemandLocks/{docId}    { allow read, write: if false; }
    match /feePendingWrites/{docId}  { allow read, write: if false; }

    // ── SA Firebase-Auth migration (Wave A) — server-only ────────
    // superAdmins: developer-SA profile/metadata (no passwords; Firebase
    // Auth holds credentials). saIpRateLimit: SA login IP throttle. Both
    // are written/read exclusively by the PHP backend via the service
    // account, which bypasses these rules. Explicit deny-all matches the
    // existing default-deny — additive intent-lock, no behavioral change.
    match /superAdmins/{docId}       { allow read, write: if false; }
    match /saIpRateLimit/{docId}     { allow read, write: if false; }

    // ── Fees Exemption v2 (Phase 0) — server-only ────────────────
    // studentServiceEnrollments: per-student opt-in to optional services
    // (transport/hostel/meals) with effective-date windows. Drives
    // enrollment-aware service-fee generation from Phase 3.
    // studentConcessions: dated, audited per-student concessions (percent
    // / fixed / fullExempt) replacing the broken exemptedFees + dead
    // discountHeads pair. Consumed by the unified generator from Phase 2.
    // Both are written/read exclusively by the PHP backend via the
    // service account; client direct access is a bug — deny explicitly.
    match /studentServiceEnrollments/{docId} { allow read, write: if false; }
    match /studentConcessions/{docId}         { allow read, write: if false; }

    // ── Fee carry-forward (Phase 9 wallet replacement) ───────────
    // Per-student doc carrying accumulated unpaid dues across
    // session boundaries. Read by Parent (FeeFirestoreRepository)
    // and Teacher (FeeFirestoreRepository) — same exposure shape
    // as feeDefaulters above. Pre-Phase-1 this had no rule block,
    // so reads silently failed under default-deny. (2026-05-07.)
    match /feeCarryForward/{docId} {
      allow read:  if isStaffOrOwnStudent();
      allow write: if isAdmin();
    }

    // ── Server-only denormalized summaries ───────────────────────
    // Written by Fee_summary_writer; read only by Fee_summary_reader
    // (PHP) and admin reports. Mobile must continue to use feeDemands
    // directly until a denormalized teacher-safe summary architecture
    // ships in Phase 4. (2026-05-07.)
    match /studentFeeSummary/{docId} { allow read, write: if false; }
    match /classFeeSummary/{docId}   { allow read, write: if false; }

    // ── Server-only webhook log ──────────────────────────────────
    // Stores raw gateway payloads + HMAC traces. PHP-only.
    // (2026-05-07.)
    match /feeOnlinePayments/{docId} { allow read, write: if false; }

    // ── Admission CRM — server-only ──────────────────────────────
    // crmApplications / crmInquiries / crmWaitlist / crmSettings /
    // crmRateLimits and admissionPayments are written and read
    // exclusively by the PHP backend (Sis.php CRM methods +
    // Admission_public) via the service account, which bypasses these
    // rules. The PUBLIC admission form also writes via the service
    // account, so there is NO client create path to validate here.
    // Direct client access is a bug — deny explicitly (matches the
    // existing default-deny catch-all; additive intent-lock, no
    // behavioral change). admissionPayments holds order_id / amount /
    // HMAC signatures and must never be client-readable. (2026-07-14.)
    match /crmApplications/{docId}   { allow read, write: if false; }
    match /crmInquiries/{docId}      { allow read, write: if false; }
    match /crmWaitlist/{docId}       { allow read, write: if false; }
    match /crmSettings/{docId}       { allow read, write: if false; }
    match /crmRateLimits/{docId}     { allow read, write: if false; }
    match /crmEnrollLocks/{docId}    { allow read, write: if false; }
    match /admissionPayments/{docId} { allow read, write: if false; }

    // ── Fee refunds ──────────────────────────────────────────────
    // Refund docs are per-student. Previously readable by any user in
    // the same school — which leaked other parents' refund history.
    // Now restricted: staff see all, parents see only their own child.
    match /feeRefunds/{docId} {
      allow read: if isStaffOrOwnStudent();
      allow create, update: if isAdmin() && isSameSchoolWrite();
      allow delete: if isAdmin() && isSameSchool();
    }
    match /feeRefundAudit/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isSameSchoolWrite();
      allow delete: if isAdmin() && isSameSchool();
    }
    match /feeRefundVouchers/{docId} {
      allow read: if isStaffOrOwnStudent();
      allow create, update: if isAdmin() && isSameSchoolWrite();
      allow delete: if isAdmin() && isSameSchool();
    }

    // ── Circulars / Notices ──────────────────────────────────────
    match /circulars/{docId} {
      allow read: if isSameSchool();
      allow create: if isStaff() && isSameSchoolWrite();
      // 2026-07-03: add isSameSchoolWrite() so an update can't rewrite the
      // doc's schoolId to another tenant (isSameSchool only validates the
      // EXISTING doc). Mirrors the events "Audit C5" hardening.
      // 2026-07-11 (notice hardening X7): update is now admin-OR-author only.
      // Previously ANY staff could edit/vandalize ANY circular (no ownership
      // check). Legitimate authoring goes through the admin panel service
      // account, which bypasses these rules entirely, so this only removes
      // the rogue-staff-SDK vector. authorId is stamped by every writer.
      allow update: if isSameSchool() && isSameSchoolWrite() && (
        isAdmin()
        || (isStaff() && resource.data.get('authorId', '') == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // Notices collection — admin Notice Board writes here; Parent + Teacher
    // apps read alongside circulars. Same permission shape as circulars.
    match /notices/{docId} {
      allow read: if isSameSchool();
      allow create: if isStaff() && isSameSchoolWrite();
      // 2026-07-11 (notice hardening X7): admin-OR-author only — see circulars.
      allow update: if isSameSchool() && isSameSchoolWrite() && (
        isAdmin()
        || (isStaff() && resource.data.get('authorId', '') == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // ── Circular Reads / Acks ────────────────────────────────────
    // 2026-07-03 lockdown: previously `write: if isAuth()` let ANY authed user
    // (any school) forge/delete ANY read receipt or ack and poison the
    // denormalized readCount. Now a user may only write their OWN receipt
    // (userId == uid), scoped to their active tenant (isSameSchoolWrite ⇒
    // tenantActive + schoolId == claim). Docs carry {circularId, userId,
    // schoolId, readAt}. Staff may read all (admin read-receipt dashboards).
    match /circularReads/{docId} {
      allow read: if isAuth() && (
        resource == null
        || resource.data.get('userId', '') == request.auth.uid
        || isStaff()
      );
      allow create, update: if isAuth()
        && isSameSchoolWrite()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Circular acknowledgements (compliance signal for requireAcknowledgement
    // circulars). Same owner-only + tenant-scoped write model as reads.
    match /circularAcks/{docId} {
      allow read: if isSameSchool();
      allow create, update: if isAuth()
        && isSameSchoolWrite()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ── Notifications ────────────────────────────────────────────
    match /notifications/{docId} {
      allow read: if isSameSchool();
      allow write: if isStaff();
    }

    // ── Events ───────────────────────────────────────────────────
    match /events/{docId} {
      allow read: if isSameSchool();
      allow create: if isStaff() && isSameSchoolWrite();
      // D6 (2026-07-12): add isSameSchoolWrite() so an update payload's
      // schoolId is re-bound to the caller's claim (was isSameSchool()-only,
      // which validated the existing doc but not the incoming schoolId).
      allow update: if isStaff() && isSameSchool() && isSameSchoolWrite();
      allow delete: if isAdmin();
    }

    // ── PTM Events (admin-managed, school-scoped read) ───────────
    match /ptmEvents/{docId} {
      allow read: if isSameSchool();
      allow create: if isStaff() && isSameSchoolWrite();
      allow update: if isStaff() && isSameSchool();
      allow delete: if isAdmin();
    }

    // ── PTM RSVPs (Phase D — section-wise, lifecycle-aware) ───────
    //
    // Architecture: Firestore-first. The parent app writes via
    // `applyToPtm()` / `declineFromPtm()` (the apply path runs inside a
    // transaction that allocates a queue number from `ptmCounters`).
    // The teacher app writes via `markDelivered()` / `markAllDelivered()`.
    //
    // These rules pin the invariants the apps already enforce so a
    // tampered client cannot bypass them:
    //
    //   PARENT (auth.uid == studentId — established by the project's
    //           parent-app auth model):
    //     • Can only create/update an RSVP whose `studentId == auth.uid`.
    //     • Can only set `status` ∈ {applied, declined}.
    //     • Cannot edit `teacherId` directly — must keep whatever the
    //       transaction set (server resolves from PTM.sections[] snapshot).
    //     • Cannot edit `queueNumber` directly — only the apply
    //       transaction allocates it from the counter.
    //
    //   TEACHER (isStaff()):
    //     • Can only update an RSVP whose `teacherId == auth.uid`
    //       (= they are the section's class teacher).
    //     • Can only flip `status` to {applied, delivered, no-show}.
    //     • Can only change the lifecycle/audit fields — not student
    //       identity, not queue number, not section.
    //
    //   ADMIN:
    //     • Reads anything in school. Deletes only.
    //     • Admin save runs via the Admin SDK (PHP), bypasses these rules.
    match /ptmRsvps/{docId} {
      allow read: if isSameSchool();

      // Parent — apply / decline / re-apply on their own RSVP doc.
      allow create:
            if isAuth()
            && request.resource.data.studentId == request.auth.uid
            && request.resource.data.schoolId == request.auth.token.school_id
            && request.resource.data.status in ["applied", "declined"];

      // Parent — update existing RSVP (status flip + note edit). The
      // apply transaction does a full set() (no merge) so it replaces the
      // doc; identity is pinned via three explicit equality checks
      // (studentId, schoolId, ptmEventId), and the rest of the keys are
      // gated by hasOnly().
      //
      // hasOnly() lists EVERY key the apply payload may carry. It mixes
      // two groups:
      //   1. Lifecycle / queue / response fields — populated by the
      //      apply transaction (status, queueNumber, teacherId, ...).
      //   2. Parent-profile snapshot fields — re-written on every apply
      //      from tokenManager.user (studentName, parentPhone, ...).
      //      These are legitimately mutable: a parent who updated their
      //      phone since the previous RSVP must be able to re-apply
      //      without rule rejection. Identity stays anchored via the
      //      pinned studentId/schoolId/ptmEventId checks above, so
      //      letting the labels drift is safe.
      allow update:
            if isAuth()
            && resource.data.studentId == request.auth.uid
            && request.resource.data.studentId == resource.data.studentId
            && request.resource.data.schoolId == resource.data.schoolId
            && request.resource.data.ptmEventId == resource.data.ptmEventId
            && request.resource.data.status in ["applied", "declined"]
            // queueNumber is server-allocated by the apply transaction.
            // The hasOnly() list below lets the key APPEAR in changed
            // keys (so the apply path that re-allocates on declined →
            // applied still works), but this clause forces the value to
            // stay equal UNLESS the update is the legitimate re-apply
            // transition. That stops a tampered client from setting an
            // arbitrary queueNumber via a plain UPDATE.
            && (
                 request.resource.data.queueNumber == resource.data.queueNumber
                 || (resource.data.status == "declined"
                     && request.resource.data.status == "applied")
               )
            && request.resource.data.diff(resource.data).changedKeys()
                 .hasOnly([
                   // Group 1 — lifecycle / queue / response.
                   "status","note","queueNumber","teacherId","teacherName",
                   "sectionKey","appliedAt","respondedAt","respondedBy",
                   "updatedAt","bookings","slotIndex","slotStartTime",
                   "slotEndTime","deliveredAt","markedBy",
                   // Group 2 — parent-profile snapshot, allowed to drift.
                   "studentName","className","section","rollNo",
                   "parentName","parentPhone","parentEmail",
                   // Group 3 — migration audit fields. Written by the
                   // admin backfill_legacy_teacher_ids endpoint to mark
                   // canonicalised legacy RSVPs. The parent apply path
                   // does a full set() with no merge, so these fields
                   // are dropped from the doc on re-apply — that counts
                   // as a changedKey, and listing them here keeps the
                   // re-apply legal. Identity remains pinned by the
                   // studentId/schoolId/ptmEventId equality checks
                   // above; allowing audit-field removal is safe.
                   "backfilledAt","backfilledBy"
                 ]);

      // Teacher — flip lifecycle on their assigned section's RSVPs.
      // The hasOnly() guard prevents this rule from being a back door
      // to mutate student identity, queue number, or section.
      allow update:
            if isStaff()
            && resource.data.teacherId == request.auth.uid
            && request.resource.data.teacherId == resource.data.teacherId
            && request.resource.data.studentId == resource.data.studentId
            && request.resource.data.status in ["applied", "delivered", "no-show"]
            && request.resource.data.diff(resource.data).changedKeys()
                 .hasOnly(["status","markedBy","markedAt","deliveredAt","updatedAt","note"]);

      allow delete: if isAdmin();
    }

    // ── PTM Counters (Phase D — apply-transaction queue allocator) ─
    //
    // Doc ID: `{schoolId}_{ptmEventId}_{sectionKey}` — each section gets
    // its own monotonically increasing counter. Updated from inside the
    // parent app's apply transaction; never edited otherwise.
    //
    //   • Read: any school member (admin RSVP page may show queue rolls).
    //   • Create/Update: any authenticated school user — but only via
    //     a transaction that's also writing the matching RSVP. Rules
    //     can't enforce "must be in the same transaction", so we just
    //     gate on schoolId membership; the `nextQueue` increment is
    //     enforced by the transaction's optimistic-concurrency check
    //     (concurrent writes retry, so no two parents get the same N).
    //   • Delete: admin only.
    match /ptmCounters/{docId} {
      allow read: if isSameSchool();
      allow create, update:
            if isAuth()
            && request.resource.data.schoolId == request.auth.token.school_id
            && request.resource.data.nextQueue is int
            && request.resource.data.nextQueue >= 1;
      allow delete: if isAdmin();
    }

    // ── Gallery ──────────────────────────────────────────────────
    // Audit C5 hardening (2026-07-02): the previous `allow write: if isStaff()`
    // had NO tenant binding on the payload — a staff token from school A could
    // create/patch a gallery doc stamped `schoolId: "SCH_B"`, writing into
    // another school's gallery (readers query by schoolId). Bind writes to the
    // caller's school on both the existing doc and the incoming payload, matching
    // the events/submissions pattern. isSameSchoolWrite() checks
    // request.resource.data.schoolId; isSameSchool() checks resource.data.schoolId.
    // Audit follow-up (2026-07-09): destructive ops were bare isStaff()+same-
    // school, so ANY staff token could delete/patch ANOTHER staff member's
    // album/media school-wide (one rogue token wipes the gallery). Restrict
    // delete to the doc's owner OR an admin, matching homework/stories. (Admin-
    // panel deletes use the Admin SDK and bypass rules, so this only tightens
    // the client surface; the Teacher app currently has no client delete path.)
    match /galleryAlbums/{docId} {
      allow read:   if isSameSchool();
      allow create: if isStaff() && isSameSchoolWrite();
      allow update: if isStaff() && isSameSchool() && isSameSchoolWrite();
      allow delete: if isStaff() && isSameSchool()
                    && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /galleryMedia/{docId} {
      allow read:   if isSameSchool();
      // FOLD baseline gating: gallery media lives under the Events module, which
      // ROLE_BASELINE_APP grants at 'view' — so a plain hasCapability('Events')
      // would be a no-op (everyone holds it). Publishing/editing media is content
      // work, so require Events at 'edit'; deletion at owner / admin / Events:manage.
      // hasCapabilityLevel() FAILS OPEN while caps are un-backfilled (rollout-safe).
      allow create: if isStaff() && isSameSchoolWrite()
                    && hasCapabilityLevel('Events', 'edit');
      allow update: if isStaff() && isSameSchool() && isSameSchoolWrite()
                    && hasCapabilityLevel('Events', 'edit');
      allow delete: if isStaff() && isSameSchool()
                    && (resource.data.uploadedBy == request.auth.uid
                        || isAdmin()
                        || hasCapabilityLevel('Events', 'manage'));
    }

    // ── Event participants ───────────────────────────────────────
    // Server-only collection: written exclusively by the admin panel via the
    // Admin SDK (Events.php), which bypasses these rules. No client (Teacher/
    // Parent app) reads or writes it. Locked to explicit deny so the intent is
    // documented and it fails loudly rather than via the generic catch-all.
    match /eventParticipants/{docId} {
      allow read, write: if false;
    }

    // ── Stories ──────────────────────────────────────────────────
    // C1 hardening (2026-07-05): the previous rule bound create/update/delete
    // to bare isStaff(), which only checks the CALLER'S own tenant — never the
    // target/payload school. A staff token from School A could create a story
    // stamped schoolId:"SCH_B" and update/delete/moderate ANY School-B story.
    // Same class of bug already fixed for galleryAlbums/galleryMedia above.
    // We bind explicitly on token.school_id (NOT isSameSchoolWrite(), whose
    // `|| schoolCode` arm is payload-spoofable — F-2) so neither the payload
    // nor the existing doc can name another tenant.
    // ── Story audience index (SEC-1) ─────────────────────────────
    // Server-maintained entitlement doc, one per parent, keyed by the
    // parent's Firebase uid. Holds the UNION of the parent's children's
    // canonical class-section keys (e.g. ["9-a","10-b"]). Written ONLY by
    // the `refreshStoryAudience` callable Cloud Function (admin creds,
    // bypasses these rules) — NEVER by a client, so a parent cannot forge
    // their own entitlement. The stories read rule below consults this doc
    // to authorise class-targeted reads server-side, replacing the old
    // client-side-only audience filter that was trivially bypassable.
    match /storyAudience/{uid} {
      allow read:  if isAuth() && uid == request.auth.uid;
      allow write: if false;
    }

    match /stories/{docId} {
      // READ (SEC-1): staff see every in-school story. A non-staff user
      // (parent) may read a story only when it is school-wide — audience
      // empty (legacy) or containing the '*' sentinel — OR it targets one
      // of THEIR children's classes, verified against the server-maintained
      // storyAudience index (NOT a client-supplied value). The exists()
      // guard keeps the rule from erroring when a parent has no index doc
      // yet (they then see only school-wide stories — fail-safe, no leak).
      allow read: if isSameSchool()
        && (
          isStaff()
          || resource.data.get('audienceClassKeys', []).size() == 0
          || ('*' in resource.data.get('audienceClassKeys', []))
          || (
            exists(/databases/$(database)/documents/storyAudience/$(request.auth.uid))
            && resource.data.get('audienceClassKeys', []).hasAny(
                 get(/databases/$(database)/documents/storyAudience/$(request.auth.uid))
                   .data.get('classKeys', []))
          )
        );

      // Staff author a story into THEIR OWN school only.
      allow create: if isStaff()
        && request.resource.data.schoolId == request.auth.token.school_id;

      // Staff delete only their own school's stories — and Stories is a BASELINE
      // module (everyone holds it at view), so deletion is gated at the graded
      // MANAGE level: a view/edit holder (teacher, peon) can post/moderate but
      // cannot destroy stories. (Same pattern applies to galleryMedia/ptmRsvps.)
      allow delete: if isStaff()
        && resource.data.schoolId == request.auth.token.school_id
        && hasCapabilityLevel('Stories', 'manage');

      // UPDATE is STAFF-ONLY and may NOT touch the engagement counters
      // (SEC-4). viewCount / reactionCounts are maintained EXCLUSIVELY
      // server-side by the Cloud Functions `onStoryViewerCreated` and
      // `onStoryReactionWritten` (admin creds, bypass these rules) off the
      // tenant-guarded viewers/reactions subcollection writes. No client —
      // staff or parent — writes them directly, so they can't be forged or
      // double-counted. Staff may still moderate/edit other fields (status,
      // caption, moderatedBy, …) within their own school; schoolId immutable.
      allow update: if isStaff()
        && resource.data.schoolId == request.auth.token.school_id
        && request.resource.data.schoolId == resource.data.schoolId
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['viewCount', 'reactionCounts']);
    }

    // Per-user story engagement markers (viewers + reactions). Declared
    // with the {path=**} collection-group form because the apps hydrate
    // "already viewed" / "my reaction" via collectionGroup() queries — a
    // rule nested under /stories/{id}/... would NOT authorize those. The
    // doc id is the app userId (e.g. "P0001"); under synthetic-email auth
    // it is NOT necessarily request.auth.uid, so identity is asserted via
    // the payload userId == doc-id + the tenant claim (below) rather than
    // request.auth.uid.
    // C2 write-side hardening (2026-07-05): previously `write: if isAuth()`
    // let ANY authenticated user (any school) forge a view/reaction under ANY
    // user's id in ANY school and poison the "who saw this" list + denormalised
    // counters. Writes are now tenant-bound: the payload must carry
    // schoolId == the caller's own claim, and the doc id must equal the
    // payload userId. The apps now stamp `schoolId` on every engagement write
    // (StoryFirestoreRepository.markAsViewed / reactToStory). Delete tolerates
    // legacy docs that predate the schoolId field.
    //
    // READ (SEC-3, C2 read-side CLOSED 2026-07-08): tenant-bound. A viewer/
    // reaction doc carries the writer's schoolId; the read now requires it to
    // equal the caller's own school_id claim, so an authenticated user of one
    // school can no longer collectionGroup()-read another tenant's "who saw
    // this" list (student/parent PII) or reaction identities. The apps' seen-
    // state / reaction-hydrate / insights queries were updated to filter
    // whereEqualTo("schoolId", <claim>) so the query aligns with this rule
    // (collection-group composite index schoolId+userId added). Legacy docs
    // that predate the schoolId field become unreadable — acceptable, they
    // belong to stories that expire within 24h and are swept.
    match /{path=**}/viewers/{uid} {
      // `resource == null` is REQUIRED, not defensive. Both apps write this
      // marker inside a transaction whose first step is get(viewers/{uid}) on
      // a doc that does not exist yet. For a missing document `resource` is
      // null, so `resource.data...` fails and the READ is denied — killing the
      // transaction before the write is ever attempted. That is why, between
      // the C2 read-side hardening (2026-07-08) and 2026-08-08, NOT ONE story
      // view or reaction was ever recorded: every story sat at viewCount=0
      // with zero viewer docs and reactionCounts={}. Allowing the get of a
      // missing doc leaks nothing (there is no data to read) and restores the
      // read-then-write path. Covered by tests/story_engagement.test.js.
      allow read: if isAuth()
        && (resource == null
            || resource.data.get('schoolId', '') == request.auth.token.school_id);
      allow create, update: if isAuth()
        && request.resource.data.userId == uid
        && request.resource.data.schoolId == request.auth.token.school_id;
      allow delete: if isAuth()
        && (!('schoolId' in resource.data)
            || resource.data.schoolId == request.auth.token.school_id);
    }
    match /{path=**}/reactions/{uid} {
      // `resource == null` is REQUIRED, not defensive. Both apps write this
      // marker inside a transaction whose first step is get(viewers/{uid}) on
      // a doc that does not exist yet. For a missing document `resource` is
      // null, so `resource.data...` fails and the READ is denied — killing the
      // transaction before the write is ever attempted. That is why, between
      // the C2 read-side hardening (2026-07-08) and 2026-08-08, NOT ONE story
      // view or reaction was ever recorded: every story sat at viewCount=0
      // with zero viewer docs and reactionCounts={}. Allowing the get of a
      // missing doc leaks nothing (there is no data to read) and restores the
      // read-then-write path. Covered by tests/story_engagement.test.js.
      allow read: if isAuth()
        && (resource == null
            || resource.data.get('schoolId', '') == request.auth.token.school_id);
      allow create, update: if isAuth()
        && request.resource.data.userId == uid
        && request.resource.data.schoolId == request.auth.token.school_id;
      allow delete: if isAuth()
        && (!('schoolId' in resource.data)
            || resource.data.schoolId == request.auth.token.school_id);
    }

    // ── Timetables ───────────────────────────────────────────────
    match /timetables/{docId} {
      allow read: if isSameSchool();
      allow write: if isStaff();
    }

    // ── Timetable Settings ──────────────────────────────────────
    match /timetableSettings/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Substitutes ─────────────────────────────────────────────
    match /substitutes/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── Staff Attendance ────────────────────────────────────────
    // ── Staff Attendance (canonical per-day) — Phase 10 hardening ─
    // Writes are Admin-SDK ONLY (PHP backend: Staff_attendance_writer +
    // HR leave path). The service account bypasses these rules, so ALL
    // client writes are denied here. Reads: a staff member may read ONLY
    // their own records (uid == staffId convention); same-school admins
    // may read any. Admin web / payroll / HR / dashboard read via the
    // Admin SDK and are unaffected by these client-facing rules.
    match /staffAttendance/{docId} {
      allow read: if isAuth() && (
            (resource != null && resource.data.staffId == request.auth.uid)
            || (isAdmin() && isSameSchool())
          );
      allow write: if false;
    }

    // ── Staff Attendance Summary (canonical per-month) ───────────
    match /staffAttendanceSummary/{docId} {
      allow read: if isAuth() && (
            (resource != null && resource.data.staffId == request.auth.uid)
            || (isAdmin() && isSameSchool())
          );
      allow write: if false;
    }

    // ── Attendance Punches (audit trail: GPS / device / manual) ──
    // Append-only audit written by the PHP backend (Admin SDK). Clients
    // never write. A staff member may read ONLY their own punch events;
    // same-school admins may read any. The attendance METHOD recorded
    // here is audit metadata only — it never influences payroll.
    match /attendancePunches/{docId} {
      allow read: if isAuth() && (
            (resource != null && resource.data.staffId == request.auth.uid)
            || (isAdmin() && isSameSchool())
          );
      allow write: if false;
    }

    // ── Calendar Events ─────────────────────────────────────────
    match /calendarEvents/{docId} {
      allow read: if isSameSchool();
      allow write: if isAdmin();
    }

    // ── Curriculum ──────────────────────────────────────────────
    // Phase 0 hardening:
    //   • Read: same-school staff or admin (parents can't see syllabus
    //     directly — that path will route through curriculumProgress in
    //     a future phase, not raw curriculum docs).
    //   • Write: admin-tier OR teacher-only. Accountant role excluded
    //     (was permitted by the prior `isStaff()` check). Per-assignment
    //     authorization is enforced server-side in PHP — Firestore rules
    //     can't see subjectAssignments without a get() round-trip.
    //   • Strict schoolId match (no schoolCode legacy fallback) — every
    //     curriculum doc written by Academic.php carries `schoolId`.
    match /curriculum/{docId} {
      allow read: if isAuth()
                  && resource != null
                  && resource.data.schoolId == request.auth.token.school_id
                  && request.auth.token.role in [
                       'Admin','admin','Teacher','teacher',
                       'School Super Admin','school_super_admin',
                       'Super Admin','super_admin','Principal','Vice Principal',
                       'Academic Coordinator'
                     ];
      allow create, update: if isAuth()
                  && request.resource.data.schoolId == request.auth.token.school_id
                  && request.auth.token.role in [
                       'Admin','admin','Teacher','teacher',
                       'School Super Admin','school_super_admin',
                       'Super Admin','super_admin','Principal',
                       'Academic Coordinator'
                     ];
      allow delete: if isAdmin()
                  && resource.data.schoolId == request.auth.token.school_id;

      // Phase 1 — topics subcollection. Each topic doc carries `schoolId`
      // (denormalized from parent) so the rule can do a direct check
      // without a get() round-trip into the parent doc. Per-assignment
      // authorization (only the assigned teacher can edit a class's
      // curriculum) is enforced server-side in PHP — see
      // Academic::_can_edit_curriculum.
      match /topics/{topicId} {
        allow read: if isAuth()
                    && resource != null
                    && resource.data.schoolId == request.auth.token.school_id
                    && request.auth.token.role in [
                         'Admin','admin','Teacher','teacher',
                         'School Super Admin','school_super_admin',
                         'Super Admin','super_admin','Principal','Vice Principal',
                         'Academic Coordinator'
                       ];
        allow create, update: if isAuth()
                    && request.resource.data.schoolId == request.auth.token.school_id
                    && request.auth.token.role in [
                         'Admin','admin','Teacher','teacher',
                         'School Super Admin','school_super_admin',
                         'Super Admin','super_admin','Principal',
                         'Academic Coordinator'
                       ];
        allow delete: if isAuth()
                    && resource.data.schoolId == request.auth.token.school_id
                    && request.auth.token.role in [
                         'Admin','admin','School Super Admin','school_super_admin',
                         'Super Admin','super_admin','Principal','Academic Coordinator'
                       ];
      }
    }

    // ── Leave Applications ───────────────────────────────────────
    // Hardened 2026-07-10 (Leave watertight pass). This ONE collection
    // holds three request shapes (student leave, staff leave, balance/
    // audit ledgers written by the PHP service account). The prior rule
    // (read/create/update: isSameSchool) allowed (a) any same-school user
    // to read EVERY student's leave reason + all staff payroll-leave, and
    // (b) any client to self-approve by writing status:'approved' directly
    // — which the PHP poller then stamped as an authoritative attendance
    // 'L'. Both closed here, mirroring the attendanceRegularizations model:
    // clients may only CREATE a 'pending' request they own and CANCEL
    // their own; APPROVE/REJECT is a same-school STAFF action on someone
    // ELSE's request (no self-approval) and can never pre-stamp attendance.
    // All immutable identity/date fields are frozen across updates. Balance
    // and audit docs (no applicantId, applicantType not student/staff) fall
    // through every client branch → writable only by the service account.
    //
    // Ownership is enforceable because auth.uid == applicantId for BOTH
    // cohorts: parent-app uid == studentId (see isOwnStudent, ~L173) and
    // staff uid == staffId (see attendanceRegularizations create, ~L320).
    match /leaveApplications/{docId} {
      // Staff see the whole school (student-leave queue + own balance);
      // students/parents see ONLY their own applications.
      allow read: if isSameSchool()
                  && ( isStaff() || resource.data.applicantId == request.auth.uid );

      // Only a brand-new 'pending' request the caller owns, never
      // pre-approved / pre-stamped. Staff-type requires an actual staff
      // claim (blocks a parent minting a paid staff leave).
      allow create: if isSameSchoolWrite()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.attendanceStamped != true
                    && request.resource.data.applicantId == request.auth.uid
                    && (
                         ( request.resource.data.applicantType == 'staff' && isStaff() )
                         || request.resource.data.applicantType == 'student'
                       );

      // Two legal transitions only; identity + dates are frozen.
      allow update: if isSameSchool()
                    && request.resource.data.schoolId == resource.data.schoolId
                    && request.resource.data.applicantId == resource.data.applicantId
                    && request.resource.data.applicantType == resource.data.applicantType
                    && request.resource.data.startDate == resource.data.startDate
                    && request.resource.data.endDate == resource.data.endDate
                    && (
                         // (a) STAFF decides someone ELSE's pending request.
                         //     No self-approval; cannot pre-stamp attendance
                         //     (the service-account poller owns the 'L' stamp).
                         //     A teacher may decide STUDENT leave, but a staff
                         //     member's own PAYROLL-bearing leave may only be
                         //     decided by an admin/principal — closes the
                         //     "any peer approves my paid leave" hole (staff-
                         //     leave approval normally runs via the panel's
                         //     Admin SDK, which bypasses these rules anyway).
                         ( isStaff()
                           && resource.data.applicantId != request.auth.uid
                           && resource.data.status == 'pending'
                           && request.resource.data.status in ['approved', 'rejected']
                           && request.resource.data.attendanceStamped != true
                           && ( resource.data.applicantType == 'student' || isAdmin() ) )
                         // (b) OWNER cancels their own pending/approved request.
                         || ( resource.data.applicantId == request.auth.uid
                              && resource.data.status in ['pending', 'approved']
                              && request.resource.data.status == 'cancelled' )
                       );

      allow delete: if isAdmin();
    }

    // ── Transport ────────────────────────────────────────────────
    match /routes/{docId} {
      allow read: if isSameSchool();
      allow write: if isAdmin();
    }

    match /vehicles/{docId} {
      allow read: if isSameSchool();
      allow write: if isAdmin();
    }

    match /studentRoutes/{docId} {
      allow read: if isSameSchool();
      allow write: if isAdmin();
    }

    // ── Library ──────────────────────────────────────────────────
    match /libraryBooks/{docId} {
      allow read: if isSameSchool();
      allow write: if isStaff();
    }

    match /libraryIssues/{docId} {
      allow read: if isSameSchool();
      allow write: if isStaff();
    }

    // Outstanding fines — read by parent / teacher / admin; written by staff.
    match /libraryFines/{docId} {
      allow read: if isSameSchool();
      allow create: if isStaff() && isSameSchoolWrite();
      allow update: if isStaff() && isSameSchool();
      allow delete: if isAdmin();
    }

    // ── Messaging (canonical Firestore schema) ───────────────────
    // Mirrors Messaging_service.php on the admin side. All three
    // collections are scoped by schoolId; teachers/parents can only
    // touch rows where they are listed as a participant.
    match /conversations/{docId} {
      allow read: if isSameSchool();
      allow create: if isAuth() && isSameSchoolWrite();
      allow update: if isAuth() && isSameSchool();
      allow delete: if isAdmin();
    }

    match /messages/{docId} {
      allow read: if isSameSchool();
      allow create: if isAuth() && isSameSchoolWrite();
      allow update: if isAuth() && isSameSchool();
      allow delete: if isAdmin();
    }

    // Inbox stubs are per-user but kept in one collection. Each doc id
    // is `{schoolId}_{role}_{userId}_{conversationId}` so we enforce
    // ownership by matching the userId field to the caller's uid OR by
    // letting same-school staff list their own inbox via query filter.
    match /messageInboxes/{docId} {
      allow read: if isSameSchool();
      allow create: if isAuth() && isSameSchoolWrite();
      allow update: if isAuth() && isSameSchool();
      allow delete: if isAuth() && isSameSchool();
    }

    // ── Salary Slips ─────────────────────────────────────────────
    match /salarySlips/{docId} {
      // Own payslip only (app getMySalarySlips filters staffId==uid; uid==staffId).
      // Admins read all via the panel (Admin SDK, bypasses rules).
      // Was isSameSchool() — leaked every staff payslip to any same-school token incl parents/students.
      allow read: if resource.data.staffId == request.auth.uid || (isAdmin() && isSameSchool());
      allow write: if isAdmin();
    }

    // ── Push Requests (teacher / admin → push pipeline) ────────
    // Staff (teacher / admin) writes a request; the Cloud Function
    // (admin SDK, bypasses rules) processes it and writes status back.
    // Reads tightened to staff only — these docs carry student/section
    // metadata about who's been notified about red flags, marks, etc.
    // and shouldn't be visible to parents/students browsing the SDK.
    match /pushRequests/{docId} {
      allow read: if isStaff() && isSameSchool();
      // Create/update gated to STAFF (not any authed user). The real writers are
      // the Admin SDK (PHP) and the Cloud Function, which bypass rules entirely;
      // an `isAuth()` create let any same-school user — including a PARENT via raw
      // SDK — forge a `mark:NOTICE_CREATED, target_group:'All School'` doc and
      // fan a spoofed school-wide push. Staff-only closes that.
      allow create: if isStaff() && isSameSchoolWrite();
      allow update: if isStaff() && isSameSchool();
      allow delete: if isStaff();
    }

    // ── User Devices (FCM token registry) ────────────────────
    // Any authenticated user can register their device. Admin
    // reads all for push delivery.
    match /userDevices/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // ── Attendance Events Fired (push dedup) ─────────────────
    // SERVER-ONLY ledger written exclusively by the Admin SDK (Attendance.php
    // _fire_* dedup). No app reads or writes it. Previously world-open to any
    // authenticated user across ALL tenants (cross-tenant PII list + parents'
    // absence-push suppression by pre-seeding the seal) — locked to deny.
    match /attendanceEventsFired/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // ── HR Jobs (recruitment) ───────────────────────────────────
    match /hrJobs/{docId} {
      allow read: if isSameSchool();
      allow write: if isAdmin();
    }

    // ── HR Applicants (recruitment) ──────────────────────────────
    match /hrApplicants/{docId} {
      // Candidate PII (applications). HR/admin only — no app client reads applicants
      // (the app reads hrJobs openings, never hrApplicants). Panel reads via Admin SDK.
      // Was isSameSchool() — exposed applicant contact details to any same-school token.
      allow read: if isAdmin() && isSameSchool();
      allow write: if isAdmin();
    }

    // ── Appraisals ──────────────────────────────────────────────
    match /appraisals/{docId} {
      // Own appraisal only (app getMyAppraisals filters staffId==uid; uid==staffId).
      // Admins read all via the panel (Admin SDK, bypasses rules).
      // Was isSameSchool() — leaked every staff appraisal to any same-school token.
      allow read: if resource.data.staffId == request.auth.uid || (isAdmin() && isSameSchool());
      allow write: if isAdmin();
    }

    // ── RBAC Roles ──────────────────────────────────────────────
    match /rbacRoles/{docId} {
      allow read: if isSameSchool();
      allow write: if isAdmin();
    }

    // ── Staff Capabilities (unified RBAC entitlement index) ──────
    // Server-maintained by the staffCapabilities Cloud Function (mirrors the PHP
    // resolve_role_access union resolver). Rules consult it via get() to enforce
    // per-module access on client writes. A staff member may read their OWN doc
    // (drives app UI); it is NEVER client-writable — the CF (Admin SDK) owns it.
    match /staffCapabilities/{uid} {
      allow read: if isAuth() && uid == request.auth.uid;
      allow write: if false;
    }

    // ── Student Red Flags (canonical Firestore source) ──────────
    // Replaces dual RTDB sources:
    //   admin RTDB: Schools/{school}/{session}/{class}/{section}/RedFlags/{sid}/{fid}
    //   mobile RTDB: StudentFlags/{schoolCode}/{studentId}/{flagId}
    // Document ID: {schoolId}_{flagId}
    match /studentFlags/{flagId} {
      // Staff (admin/teacher/principal/etc.) can read all flags in their school.
      allow read: if isStaff() && (
        resource == null
        || resource.data.schoolId   == request.auth.token.school_id
        || resource.data.schoolCode == request.auth.token.school_id
      );

      // Parents/students read flags for their own student record.
      // Three fallbacks for studentId ownership, in preferred order:
      //   1. `student_ids` array claim (canonical multi-child setup)
      //   2. `student_id` single claim (legacy)
      //   3. `request.auth.uid` (this install logs students in with their
      //      studentId as the Auth UID, so the doc's studentId equals
      //      auth.uid and no extra claim is needed)
      // The role gate is kept loose ('Parent'/'parent'/'Student'/'student'
      // or empty) because not every backend mints a role claim.
      // H-LIFECYCLE parity (2026-07-02): parents, like staff, are locked out
      // of a suspended/expired tenant. Previously this arm used raw isAuth()
      // with no tenantActive() gate, so suspended-tenant parents could still
      // read flags while every other collection blocked them.
      allow read: if isAuth()
        && resource != null
        && tenantActive(request.auth.token.school_id)
        && (resource.data.schoolId   == request.auth.token.school_id
            || resource.data.schoolCode == request.auth.token.school_id
            || resource.data.schoolId   == request.auth.token.get('school_code', '')
            || resource.data.schoolCode == request.auth.token.get('school_code', ''))
        && (
          resource.data.studentId in request.auth.token.get('student_ids', [])
          || resource.data.studentId == request.auth.token.get('student_id', '')
          || resource.data.studentId == request.auth.uid
        );

      // Staff create flags as themselves with canonical lowercase enums.
      // createdByRole stamps the origin so soft-delete can enforce
      // "teachers can only delete what teachers created".
      // 2026-07-02: also require the identity/ordering fields the UPDATE rule
      // depends on (studentId/flagId/createdAtMs) to be present & valid, so a
      // flag can never be written in a state that makes it un-resolvable or
      // invisible to the createdAtMs-ordered feeds.
      allow create: if isStaff()
        && isSameSchoolWrite()
        && hasCapability('Red Flags')
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.studentId != ''
        && request.resource.data.flagId != ''
        && request.resource.data.createdAtMs > 0
        && request.resource.data.status   == 'active'
        && request.resource.data.type     in ['homework', 'behavior', 'performance']
        && request.resource.data.severity in ['low', 'medium', 'high']
        && request.resource.data.createdByRole in ['admin', 'teacher'];

      // Updates cover BOTH resolve (status→'resolved') and soft-delete
      // (status→'deleted'). Permission model (ENFORCED, 2026-07-02 — the
      // prior rule documented this but only checked school membership, so
      // ANY same-school staff could resolve/delete ANY flag, incl. admin-
      // created ones — a moderation-integrity hole the clients assumed was
      // closed):
      //   - Admin: any status transition on any flag in their school.
      //   - Other staff (teacher): ONLY on flags they own (teacherId == uid).
      //       · resolve  → allowed on own flags.
      //       · soft-delete → additionally requires createdByRole == 'teacher'
      //         (a teacher cannot retract an admin-issued flag routed to them).
      // status is enum-constrained on every path so a bad value can't break
      // the status-ordered indexes. Immutable identity + semantic fields use
      // .get(default) so legacy docs missing a field stay resolvable rather
      // than erroring the whole rule. schoolCode fallback mirrors the read
      // rule so legacy schoolCode-only docs are moderatable, not frozen.
      allow update: if
        (resource.data.schoolId == request.auth.token.school_id
         || resource.data.get('schoolCode', '') == request.auth.token.school_id)
        && request.resource.data.status in ['active', 'resolved', 'deleted']
        && request.resource.data.get('studentId',  '') == resource.data.get('studentId',  '')
        && request.resource.data.get('flagId',     '') == resource.data.get('flagId',     '')
        && request.resource.data.get('teacherId',  '') == resource.data.get('teacherId',  '')
        && request.resource.data.get('createdAtMs', 0) == resource.data.get('createdAtMs', 0)
        && request.resource.data.get('severity', '') == resource.data.get('severity', '')
        && request.resource.data.get('type',     '') == resource.data.get('type',     '')
        && request.resource.data.get('message',  '') == resource.data.get('message',  '')
        && request.resource.data.get('subject',  '') == resource.data.get('subject',  '')
        && (
          isAdmin()
          || (
            isStaff()
            && resource.data.get('teacherId', '') == request.auth.uid
            && (
              request.resource.data.status == 'resolved'
              || (
                request.resource.data.status == 'deleted'
                && resource.data.get('createdByRole', '') == 'teacher'
              )
            )
          )
        );

      // Hard-delete still admin-only — soft-delete is the canonical path
      // (preserves audit trail). Kept for genuine purges by an admin tool.
      allow delete: if isAdmin()
        && (resource.data.schoolId == request.auth.token.school_id
            || resource.data.get('schoolCode', '') == request.auth.token.school_id);
    }


    // ── Project-wide Audit Logs ──────────────────────────────────
    // Written by the PHP `log_audit()` helper through a service account
    // (bypasses these rules). Client reads are restricted to admin-tier
    // roles in the same school. Client writes are NEVER allowed — audit
    // integrity depends on the server being the only writer.
    match /auditLogs/{logId} {
      allow read: if isAuth()
                  && resource != null
                  && resource.data.schoolId == request.auth.token.school_id
                  && request.auth.token.role in [
                       'Admin','admin',
                       'Super Admin','super_admin',
                       'School Super Admin','school_super_admin',
                       'Principal'
                     ];
      allow write: if false;
    }

    // Same shape as auditLogs; populated by audit_archive_old() when the
    // active log count exceeds the per-school cap.
    match /auditArchive/{logId} {
      allow read: if isAuth()
                  && resource != null
                  && resource.data.schoolId == request.auth.token.school_id
                  && request.auth.token.role in [
                       'Admin','admin',
                       'Super Admin','super_admin',
                       'School Super Admin','school_super_admin',
                       'Principal'
                     ];
      allow write: if false;
    }

    // ── Academic Audit Log (Phase 4) ─────────────────────────────
    // Write-only from server (PHP backend uses service account → bypasses rules).
    // Reads restricted to admin-tier roles within the same school. NO client
    // writes ever — log integrity depends on this being server-only.
    match /academicAuditLog/{logId} {
      allow read: if isAuth()
                  && resource != null
                  && resource.data.schoolId == request.auth.token.school_id
                  && request.auth.token.role in [
                       'Admin','admin',
                       'School Super Admin','school_super_admin',
                       'Super Admin','super_admin','Principal'
                     ];
      allow write: if false;
    }

    // ── Super Admin per-account lockout state (AUTH-C2, 2026-05-27) ──
    // Server-only. State managed by Superadmin_login::authenticate flow:
    //   - read on lockout pre-check
    //   - written on failed attempt (with sliding 30-min window)
    //   - deleted on successful login
    // No client read or write is ever legitimate — deny absolutely.
    match /superadminAuthState/{docId} {
      allow read, write: if false;
    }

    // ── Wave B2.2-F (2026-05-30): Firestore-only control-plane (F3) ──
    // Server-only collections. All writes (and reads except tenantPublic)
    // bypass these rules via the Admin SDK service account (rules:4-6);
    // these deny-alls are an intent-lock matching the established
    // feeLocks/superAdmins pattern (606-611, 619-620). Additive over
    // non-existent collections — zero current-behavior change.
    //
    // PERMANENT (survive B2.8): schoolControl/plans/subscriptions/invoices/
    //   payments/revenueByPeriod/schoolSsa/tenantAudit/schoolCodeIndex/
    //   schoolNameIndex/billingClaims + tenantPublic client-read rule.
    // SCAFFOLDING (retired at B2.8 with the bridge): _b2_pending.
    match /schoolControl/{docId}    { allow read, write: if false; }
    match /plans/{docId}            { allow read, write: if false; }
    match /subscriptions/{docId}    { allow read, write: if false; }
    match /invoices/{docId}         { allow read, write: if false; }
    match /payments/{docId}         { allow read, write: if false; }
    match /revenueByPeriod/{docId}  { allow read, write: if false; }
    match /schoolSsa/{docId}        { allow read, write: if false; }
    match /tenantAudit/{docId}      { allow read, write: if false; }
    match /schoolCodeIndex/{docId}  { allow read, write: if false; }
    match /schoolNameIndex/{docId}  { allow read, write: if false; }
    match /billingClaims/{docId}    { allow read, write: if false; }

    // tenantPublic — thin client-readable mirror (name, logoUrl, activeModules,
    // accessAllowed). Read scoped to same school; carries NO billing or money.
    // Write is server-only (Admin SDK bypasses).
    match /tenantPublic/{docId} {
      allow read: if isAuth() && (
        resource.data.schoolId == request.auth.token.school_id ||
        docId == request.auth.token.school_id
      );
      allow write: if false;
    }

    // _b2_pending — MIGRATION SCAFFOLDING (retired at B2.8 with the
    // RTDB<->Firestore bridge). Forward-reconciler marker keyed by
    // (schoolId, op). Server-only.
    match /_b2_pending/{docId}      { allow read, write: if false; }

    // ── Deny everything else (catch-all) ─────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
