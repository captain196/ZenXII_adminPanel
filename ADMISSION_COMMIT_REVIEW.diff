+    public function admission_receipt()
+    {
+        $this->_require_role(self::VIEW_ROLES, 'crm_view');
+        $rk = trim((string) $this->input->get('receipt'));
+        if ($rk === '' || !preg_match('/^ADM[0-9]{4,10}$/', $rk)) return show_404();
