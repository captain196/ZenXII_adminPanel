# Environment & secrets
.env
.env.local
.env.production

# Firebase credentials (service account keys)
application/config/*-firebase-adminsdk-*.json
application/config/*-adminsdk-*.json

# Session files
application/sessions/*
!application/sessions/.gitkeep

# Cache files
application/cache/token_*.json
application/cache/firebase_circuit.json
application/cache/ops_students_*
# Runtime cache artifacts — regenerated at runtime, must never be committed.
# firebase_auth/ holds the live OAuth access token (a secret); dashboard/ holds
# per-tenant dashboard caches that churn on every load.
application/cache/firebase_auth/
application/cache/dashboard/

# Log files
application/logs/*.php
application/logs/.debug_enabled

# Vendor (if using composer install on deploy)
# vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code session metadata
.claude/

# OS
.DS_Store
Thumbs.db

# Runtime cache + logs — regenerated live, must never be committed (unblocks prod FF).
application/cache/
application/logs/*.log
