+    /**
+     * Handle OPTIONAL admission file uploads from the public form.
+     *
+     * Inputs (all optional): `photo` (student photo, images only),
+     * `aadhaar_card` (image/PDF) and `documents[]` (multiple supporting
+     * files). Each is validated against an extension + MIME allowlist and a
+     * 1 MB cap, then uploaded to Firebase Cloud Storage under
+     *   admission/{schoolId}/{appId}/…
+     * using the existing service-account client (Firebase::uploadFile —
+     * Admin write, so no client Storage rule is required). Returns the
+     * tokenized download URLs for persistence on the application doc.
+     *
+     * On the first invalid file it returns early with a human-readable
+     * `error`; the caller rejects the whole submit before writing anything.
+     *
+     * @return array{photo_url:string, aadhaar_url:string, documents:array, error:?string}
+     */
+    private function _handle_admission_uploads(string $school_id, string $appId): array
+    {
+        $out = ['photo_url' => '', 'aadhaar_url' => '', 'documents' => [], 'error' => null];
+        if (empty($_FILES)) return $out;
+
+        $MAX = 1048576; // 1 MB, matching the form's stated limit
+        $imgExt = ['jpg', 'jpeg', 'png', 'gif'];
+        $docExt = ['jpg', 'jpeg', 'png', 'gif', 'pdf', 'doc', 'docx', 'xls', 'xlsx'];
+        $mimeOk = [
+            'image/jpeg', 'image/png', 'image/gif', 'application/pdf',
+            'application/msword',
+            'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
+            'application/vnd.ms-excel',
+            'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
+            // legacy Office / generic streams are reported inconsistently across
+            // servers — tolerate octet-stream (extension allowlist still gates it)
+            'application/octet-stream',
+        ];
+
+        $detectMime = function (string $tmp): string {
+            if (function_exists('finfo_open')) {
+                $fi = finfo_open(FILEINFO_MIME_TYPE);
+                if ($fi) { $m = finfo_file($fi, $tmp); finfo_close($fi); if (is_string($m) && $m !== '') return $m; }
+            }
+            return '';
+        };
+        $safeName = function (string $name): string {
+            $name = preg_replace('/[^A-Za-z0-9._-]/', '_', basename($name));
+            return substr($name, 0, 80) ?: 'file';
+        };
+
+        // Validate + upload ONE file. Returns [downloadUrl, errorOrNull].
+        $upl = function (array $file, array $allowExt, string $label, string $prefix)
+                use ($school_id, $appId, $MAX, $mimeOk, $detectMime, $safeName): array {
+            $err = $file['error'] ?? UPLOAD_ERR_NO_FILE;
+            if ($err === UPLOAD_ERR_NO_FILE) return ['', null];          // not provided — OK (optional)
+            if ($err !== UPLOAD_ERR_OK)     return ['', "{$label}: upload failed. Please try again."];
+            $size = (int) ($file['size'] ?? 0);
+            if ($size <= 0) return ['', null];
+            if ($size > $MAX) return ['', "{$label} is larger than 1 MB. Please upload a smaller file."];
+            $ext = strtolower(pathinfo($file['name'] ?? '', PATHINFO_EXTENSION));
+            if ($ext === '' || !in_array($ext, $allowExt, true)) {
+                return ['', "{$label}: unsupported file type. Allowed: " . strtoupper(implode(', ', $allowExt)) . '.'];
+            }
+            $tmp = (string) ($file['tmp_name'] ?? '');
+            if ($tmp === '' || !is_uploaded_file($tmp)) return ['', "{$label}: invalid upload."];
+            $mime = $detectMime($tmp);
+            if ($mime !== '' && !in_array($mime, $mimeOk, true)) {
+                return ['', "{$label}: file content not recognised. Please upload a valid file."];
+            }
+            $remote = "admission/{$school_id}/{$appId}/{$prefix}_" . $safeName((string) ($file['name'] ?? 'file'));
+            if (!$this->firebase->uploadFile($tmp, $remote)) {
+                return ['', "{$label}: could not be uploaded. Please try again."];
+            }
+            return [$this->firebase->getDownloadUrl($remote), null];
+        };
+
+        // Student photo (images only)
+        if (isset($_FILES['photo'])) {
+            [$url, $e] = $upl($_FILES['photo'], $imgExt, 'Student photo', 'photo');
+            if ($e !== null) { $out['error'] = $e; return $out; }
+            $out['photo_url'] = $url;
+        }
+        // Aadhaar card (image or PDF)
+        if (isset($_FILES['aadhaar_card'])) {
+            [$url, $e] = $upl($_FILES['aadhaar_card'], $docExt, 'Aadhaar card', 'aadhaar');
+            if ($e !== null) { $out['error'] = $e; return $out; }
+            $out['aadhaar_url'] = $url;
+        }
+        // Supporting documents — <input name="documents[]" multiple>
+        if (isset($_FILES['documents']) && is_array($_FILES['documents']['name'] ?? null)) {
+            $n = count($_FILES['documents']['name']);
+            if ($n > 10) { $out['error'] = 'Please upload at most 10 supporting documents.'; return $out; }
+            for ($i = 0; $i < $n; $i++) {
+                $one = [
+                    'name'     => $_FILES['documents']['name'][$i]     ?? '',
+                    'tmp_name' => $_FILES['documents']['tmp_name'][$i] ?? '',
+                    'error'    => $_FILES['documents']['error'][$i]    ?? UPLOAD_ERR_NO_FILE,
+                    'size'     => $_FILES['documents']['size'][$i]     ?? 0,
+                ];
+                [$url, $e] = $upl($one, $docExt, 'Document', 'doc' . ($i + 1));
+                if ($e !== null) { $out['error'] = $e; return $out; }
+                if ($url !== '') {
+                    $out['documents'][] = [
+                        'name'     => $safeName((string) ($one['name'] ?: ('Document ' . ($i + 1)))),
+                        'url'      => $url,
+                        'category' => 'document',
+                    ];
+                }
+            }
+        }
+
+        return $out;
+    }
+
