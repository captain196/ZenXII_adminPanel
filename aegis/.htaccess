# Aegis is developer tooling, not part of the web application.
#
# This directory ships to the Ohio production box because it lives in the same
# repo the server pulls. The root .htaccess already denies .json/.md/.sh/.yml,
# but NOT .js — so without this rule aegis/cli.js and every module under
# rules/, indexes/ and lib/ would be readable at https://zenxii.com/aegis/.
#
# Nothing here is ever meant to be served. Deny the whole directory.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
